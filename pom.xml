<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>chat-parent</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <name>Demo Chat Parent</name>

    <properties>
        <image.repo>${env.IMAGE_REPO_PREFIX}</image.repo>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>25</java.version>
        <kotlin.version>2.4.10</kotlin.version>
        <!-- Boot 4.0.8 manages tomcat 11.0.24, and the daily audit reports
             four findings against it at 9.1 and 9.8. Tomcat reaches this
             reactor through chat-authorization-server alone, which uses
             spring-boot-starter-web. Overriding the Boot property is the
             supported route, and it keeps the version out of every module
             pom. See CHAT-icgifzbv. -->
        <tomcat.version>11.0.26</tomcat.version>
        <spring-boot.version>4.0.8</spring-boot.version>
        <spring-cloud-bom.version>2025.1.3</spring-cloud-bom.version>

        <!-- No BOM manages these. They are declared once in
             dependencyManagement below. A module must not repeat a version.
             See CHAT-mgtbicsq. -->
        <!-- Reactor 3.8 and the two add-ons that ship beside it in reactor-bom
             2025.0.7. reactor-netty is deliberately absent. Read the comment in
             dependencyManagement before you change any of the three. -->
        <reactor.version>3.8.7</reactor.version>
        <reactor-kotlin.version>1.3.2</reactor-kotlin.version>
        <reactor-extra.version>3.6.1</reactor-extra.version>
        <!-- Testcontainers 2, above the 1.21.4 line that the Boot BOM manages.
             Version 2 renames every module artifact to testcontainers-<name>.
             The core artifact keeps its name. See CHAT-vjsbfecx. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <lucene.version>8.7.0</lucene.version>
        <mockito-kotlin.version>4.1.0</mockito-kotlin.version>
        <testng.version>7.12.0</testng.version>
        <webjars-bootstrap.version>3.4.1</webjars-bootstrap.version>
        <webjars-jquery.version>3.4.1</webjars-jquery.version>
        <vectors.version>0.1.20</vectors.version>
        <!-- kotlin-stdlib brings 13.0 and kotlinx-coroutines wants 23.0.0.
             Maven picks the nearer one, so the higher request loses.
             Pinned here to satisfy requireUpperBoundDeps. -->
        <jetbrains-annotations.version>23.0.0</jetbrains-annotations.version>
        <!-- The Cassandra driver brings 2.1.12 and micrometer-core wants
             2.2.2. Pinned here to satisfy requireUpperBoundDeps. -->
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <!-- Boot manages 2.4 and spring-cloud wants 2.5. -->
        <snakeyaml.version>2.5</snakeyaml.version>
        <!-- Three versions reach the tree. Pinned to the highest so
             dependencyConvergence passes. Raised from 10.0.2 on 2026-09-18,
             because spring-security-oauth2-jose 7.0.7 needs 10.4 and the older
             value became a downgrade. See CHAT-mndvipyh. -->
        <nimbus-jose-jwt.version>10.4</nimbus-jose-jwt.version>
        <!-- Three versions reach the tree: 4.5.5, 4.5.13 and 4.5.14. -->
        <httpclient.version>4.5.14</httpclient.version>
        <!-- The cassandra driver brings 9.2 through jnr-ffi, and chat-webflux
             wants 9.7.1 through oauth2-oidc-sdk and accessors-smart. Maven
             picks the nearer 9.2, so the higher request loses. The pair meets
             only under -Pexpose-webflux on a cassandra deployment. Pinned here
             to satisfy requireUpperBoundDeps. See CHAT-xwycjyla. -->
        <asm.version>9.7.1</asm.version>
        <vector.api.module.flag>--add-modules=jdk.incubator.vector</vector.api.module.flag>
        <!-- Overridden to empty by -Pintegration. See maven-surefire-plugin below. -->
        <excluded.test.groups>integration</excluded.test.groups>
    </properties>

