#!/usr/bin/env bash
# Build the shell CLI and MCP runtimes and stage them in one directory. See
# CHAT-bjqzvsoe.
#
#   build-shell-cli-lib <new-stage-directory>
#
# The stage holds shell jars, MCP jars under mcp/, and shell-cli.options.
# An installed node-9 home takes that directory as its lib/.
# The launchers then need no repository, Maven, or ~/.m2.
#
# shell-cli.options records the identity, connection ports, Java selection, and source stamp in comment headers.
# Each remaining line holds one JVM option from CHAT_SHELL_CLI_PRINT_OPTIONS.
# The file holds no login or secret.
#
# A failed build leaves no stage directory. The work happens in a temporary
# directory beside the target, and one rename completes it.
#
# The build prints one line for each phase. Each line carries the phase time.
# Full Maven output goes to a log file. A failed phase names its log, and it
# prints the last 40 lines of that log. See CHAT-gwrrazjg.
#
# Every Maven build step runs clean. So no earlier target directory reaches
# the stage. The copy-only steps add no clean, because a clean would remove
# the module jar that the next step reads.
#
# The root pom.xml applies git-commit-id-maven-plugin to every module. So
# each module jar holds git.properties. One phase reads that file from every
# staged chat jar. It compares each git.commit.id with the commit of the
# working tree. A mismatch stops the build before the stage moves. So an
# installed jar set cannot be older than the working tree. A dirty tree is
# allowed, and the proof records the dirty flag. The proof cannot show that
# an uncommitted change reached a jar.
set -uo pipefail

# The caller supplies identity and connection values before staging.

fail() {
    printf 'build-shell-cli-lib: %s\n' "$1" >&2
    exit "${2:-1}"
}

# status TEXT  Print one progress line. chat-deploy uses the same idiom.
status() { printf 'build-shell-cli-lib: %s\n' "$1"; }

# The phase count of a complete run. Each phase prints a start line and an
# end line, so a long run never stays silent. See CHAT-gwrrazjg.
total_phases=6
phase=0

# run_phase NAME LOG COMMAND...  Run one phase and write its output to LOG.
# A failed phase names the log, prints the end of the log, and removes the
# stage. The log stays outside the stage, so a failure keeps it.
run_phase() {
    local name="$1" log="$2" started=$SECONDS rc=0
    shift 2
    phase=$((phase + 1))
    status "[$phase/$total_phases] $name"
    "$@" > "$log" 2>&1 || rc=$?
    if (( rc != 0 )); then
        status "$name failed after $((SECONDS - started)) s. Its log is at $log" >&2
        tail -n 40 "$log" >&2
        rm -rf "$tmp"
        exit 1
    fi
    status "[$phase/$total_phases] $name done in $((SECONDS - started)) s"
    rm -f "$log"
}

(( $# == 1 )) || fail 'use <new-stage-directory>' 2
stage="$1"
[[ ! -e "$stage" && ! -L "$stage" ]] || fail "the stage path $stage exists" 2

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
launcher="$repo_root/shell-scripts/chat-shell-cli"
[[ -x "$launcher" ]] || fail "no launcher at $launcher" 2
. "$repo_root/shell-scripts/node-inputs.sh"
chat_node_inputs || exit $?
if declare -F chat_legacy_stage_inputs > /dev/null; then
    chat_legacy_stage_inputs
fi

# CHAT_BUILD_MVN and CHAT_BUILD_JAVA select the build tools.
# The temporary compatibility reader translates their legacy names before this selection.
mvn_command="${CHAT_BUILD_MVN:-mvn}"
java_command="${CHAT_BUILD_JAVA:-java}"
command -v "$mvn_command" > /dev/null 2>&1 \
    || fail "no mvn at $mvn_command. The build needs Maven." 2
command -v "$java_command" > /dev/null 2>&1 \
    || fail "no java at $java_command. The build needs a JDK." 2
java_path="$(command -v "$java_command")"
key_type="${CHAT_SHELL_KEY_TYPE:-${NODE_KEY_TYPE:-}}"
node_id="${CHAT_SHELL_NODE_ID:-${NODE_ID:-}}"
[[ -n "$key_type" && -n "$node_id" ]] \
    || fail 'supply a profile or explicit key type and node ID.' 2
export CORE_PORT="${CORE_PORT:-${NODE_RSOCKET_PORT:-}}"
export CORE_MGMT_PORT="${CORE_MGMT_PORT:-${NODE_MGMT_PORT:-}}"
[[ -n "$CORE_PORT" && -n "$CORE_MGMT_PORT" ]] \
    || fail 'supply explicit core ports or a profile.' 2

probe_lib="$repo_root/shell-scripts/java-probe.sh"
[[ -f "$probe_lib" ]] || fail "no java probe library at $probe_lib" 2
# shellcheck source=java-probe.sh
. "$probe_lib"

# Maven selects its own JDK through JAVA_HOME. So CHAT_BUILD_JAVA must also set
# that path, or the build compiles with one JDK and the launcher runs another.
#
# The home comes from the JVM, and never from the path of the java. A path can
# lie. macOS ships a stub at /usr/bin/java, and a matching stub at
# /usr/bin/javac, so the parent of the bin directory is /usr, and no path test
# tells that directory from a JDK home. An earlier version of this script
# exported JAVA_HOME=/usr. Maven then started the stub with that value, and the
# stub reached no main class. It held one core and printed no line.
#
# A JDK home holds bin/javac and the release file. The build keeps the
# JAVA_HOME of the caller when the named java reports no such home. A caller
# that names no java keeps JAVA_HOME as well, because that value is the
# selection of the environment. On a host with sdkman, it is the home of the
# current candidate. See CHAT-faqxupam and CHAT-bjqzvsoe.
if [[ -n "${CHAT_BUILD_JAVA:-}" ]]; then
    # The query starts a JVM. A stub java with no JDK holds its caller, so the
    # CHAT_JAVA_PROBE_LIMIT_S bounds the probe in seconds.
    java_limit_s="${CHAT_JAVA_PROBE_LIMIT_S:-30}"
    java_home="$(java_probe_run "$java_limit_s" "$java_command" \
        -XshowSettings:properties -version \
        | sed -nE 's/^[[:space:]]*java\.home = (.*)$/\1/p' | head -1)"
    if [[ -n "$java_home" && -x "$java_home/bin/javac" \
          && -f "$java_home/release" ]]; then
        export JAVA_HOME="$java_home"
    else
        printf 'build-shell-cli-lib: %s reports no JDK home, so JAVA_HOME keeps its value. Maven selects its own JDK.\n' \
            "$java_path" >&2
    fi
fi

parent="$(dirname "$stage")"
[[ -d "$parent" ]] || fail "the parent directory $parent is absent" 2
tmp="$(mktemp -d "$parent/.shell-cli-lib-XXXXXX")" \
    || fail 'no temporary directory'

# The reactor build comes first. A one module build of chat-deploy resolves
# every sibling module from the local repository, and a fresh host holds none
# of them. node3 failed that way: "Could not find artifact
# com.demo:chat-core:jar:0.0.1". So this step builds chat-deploy with -am,
# which adds the modules that it needs, and it installs them. A host that
# already holds them does an incremental build.
#
# This step names no profile. The four profiles of the copy step make
# chat-deploy depend on chat-shell, and chat-shell depend on chat-deploy, so a
# reactor of both modules holds a cycle: "The projects in the reactor contain a
# cyclic reference". The modules install without those profiles, and the copy
# step then reads them from the local repository. See CHAT-tqsteufr.
# The step skips the test run, and it compiles the tests. maven.test.skip=true
# skips both, and the test jar of chat-core then never reaches the local
# repository. chat-security needs that jar: node3 reported "The following
# artifacts could not be resolved: com.demo:chat-core:jar:tests:0.0.1".
# The list names the four modules of the copy step, so the step installs
# chat-shell, chat-shell-host, and chat-client-rsocket as well. Those three
# reach chat-deploy through its profiles alone, so -am without a profile never
# adds them, and the copy step then finds no chat-shell jar. node3 reported
# that too: "could not be resolved: com.demo:chat-shell:jar:0.0.1".
# The step runs clean. So no earlier target directory of these modules
# reaches the local repository. See CHAT-gwrrazjg.
run_phase 'module build' "$tmp.reactor.log" \
    "$mvn_command" -B -ntp -f "$repo_root/pom.xml" \
    -pl chat-deploy,chat-shell,chat-shell-host,chat-client-rsocket -am \
    -DskipTests clean install

# The dependency copy follows. It runs on chat-deploy alone, so the stage holds
# the runtime set of that module and nothing of another module.
# clean runs first. So the module jar of this step comes from a new compile.
# The step reads each sibling module from the local repository, and the
# module build above refreshed that repository.
run_phase 'dependency copy' "$tmp.log" \
    "$mvn_command" -B -ntp -f "$repo_root/chat-deploy/pom.xml" \
    -Pdeploy,shell,shell-host,client-backend -Dmaven.test.skip=true \
    clean package dependency:copy-dependencies -DincludeScope=runtime \
    -DoutputDirectory="$tmp"

# The plain module jar of chat-deploy joins the dependencies. The Spring Boot
# repackage of that module, chat-deploy-*-exec.jar, stays out. That file holds
# every dependency again under BOOT-INF, so it adds 63 MB and no plain
# classpath can read it. The main class itself comes from chat-shell-*.jar,
# which the dependency copy already staged.
# The dependency copy writes the module jar under chat-deploy/target. A test
# points this name at a fixture, so the suite needs no packaged module.
# CHAT_MCP_TARGET_DIR below serves the same purpose for the MCP module.
deploy_target="${CHAT_DEPLOY_TARGET_DIR:-$repo_root/chat-deploy/target}"
while IFS= read -r jar; do
    cp "$jar" "$tmp/" || { rm -rf "$tmp"; fail 'cannot copy the module jar'; }
done < <(find "$deploy_target" -maxdepth 1 -name '*.jar' \
    -not -name '*-exec.jar' -not -name '*-sources.jar' \
    -not -name '*-javadoc.jar' 2> /dev/null)
rm -f "$tmp"/*-exec.jar

# Stage the MCP adapter beside the shell runtime. The installed launcher reads
# this directory without a source tree or a local Maven repository.
# This step runs after the chat-deploy module jar copy above. So its clean
# removes no jar that this script still needs.
run_phase 'MCP build' "$tmp.mcp-build.log" \
    "$mvn_command" -B -ntp -f "$repo_root/pom.xml" \
    -pl chat-mcp -am -DskipTests clean install
mkdir -p "$tmp/mcp"
# This step adds no clean. The MCP build above wrote the module jar under
# chat-mcp/target, and the staging step below reads that jar.
run_phase 'MCP dependency copy' "$tmp.mcp-copy.log" \
    "$mvn_command" -B -ntp -f "$repo_root/chat-mcp/pom.xml" \
    dependency:copy-dependencies -DincludeScope=runtime \
    -DoutputDirectory="$tmp/mcp"
# The MCP build writes the module jar under chat-mcp/target. A test points this
# name at a fixture, so the suite needs no packaged module.
mcp_target="${CHAT_MCP_TARGET_DIR:-$repo_root/chat-mcp/target}"
mcp_main=0
for jar in "$mcp_target"/chat-mcp-*.jar; do
    [[ -f "$jar" ]] || continue
    case "$jar" in *-sources.jar|*-javadoc.jar|*-tests.jar) continue ;; esac
    cp "$jar" "$tmp/mcp/" || { rm -rf "$tmp"; fail 'cannot copy the MCP jar'; }
    count="$(unzip -l "$jar" 2> /dev/null | grep -c 'com/demo/chat/mcp/McpAdapterMainKt.class')"
    (( count > 0 )) && mcp_main=$(( mcp_main + 1 ))
done
(( mcp_main > 0 )) || { rm -rf "$tmp"; fail 'no staged MCP jar holds McpAdapterMainKt.class'; }
chmod 644 "$tmp/mcp"/*.jar

# -- The git stamp proof -------------------------------------------------
#
# Each module jar holds git.properties, because the root pom.xml applies
# git-commit-id-maven-plugin to every module. The proof compares the stamp of
# each staged chat jar with the commit of the working tree.
#
# The proof runs before the rename. So a stale jar set leaves no stage, and
# the installed home keeps its earlier runtime.
#
# A measurement of 2026-10-29 shows the need. The installed lib/ held jars of
# 653b5e6, the target directories held 0cae0c1, and the working tree was at
# 19493801. The install reported success. See CHAT-gwrrazjg.
phase=$((phase + 1))
status "[$phase/$total_phases] git stamp proof"
stamp_started=$SECONDS
tree_commit="$(git -C "$repo_root" rev-parse HEAD 2> /dev/null)"
[[ -n "$tree_commit" ]] \
    || { rm -rf "$tmp"; fail 'cannot read the commit of the working tree.'; }
if [[ -n "$(git -C "$repo_root" status --porcelain 2> /dev/null)" ]]; then
    tree_dirty=true
else
    tree_dirty=false
fi
stamped=0
for jar in "$tmp"/chat-*.jar "$tmp"/mcp/chat-*.jar; do
    [[ -f "$jar" ]] || continue
    jar_commit="$(unzip -p "$jar" git.properties 2> /dev/null \
        | sed -nE 's/^git\.commit\.id=([0-9a-f]+).*/\1/p' | head -1)"
    if [[ -z "$jar_commit" ]]; then
        rm -rf "$tmp"
        fail "${jar##*/} holds no git.properties stamp. No proof covers the jar set."
    fi
    if [[ "$jar_commit" != "$tree_commit" ]]; then
        rm -rf "$tmp"
        fail "${jar##*/} comes from commit $jar_commit, and the working tree is at $tree_commit. The build is not fresh."
    fi
    stamped=$((stamped + 1))
done
(( stamped > 0 )) \
    || { rm -rf "$tmp"; fail 'the stage holds no chat module jar. No stamp proves the stage.'; }
status "[$phase/$total_phases] git stamp proof done in $((SECONDS - stamp_started)) s. $stamped jars at $tree_commit, dirty $tree_dirty"
if [[ "$tree_dirty" == 'true' ]]; then
    status 'the working tree is dirty. The proof covers the commit alone.'
fi

# The frozen options come from the launcher of this tree. The print hook ends
# before any JVM start, so this call reaches no core.
phase=$((phase + 1))
status "[$phase/$total_phases] options freeze"
if ! options="$(CHAT_SHELL_JAVA="$java_command" \
    CHAT_SHELL_KEY_TYPE="$key_type" CHAT_SHELL_NODE_ID="$node_id" \
    CHAT_SHELL_CLI_PRINT_OPTIONS=1 CHAT_SHELL_LIB='' "$launcher" whoami \
    2> "$tmp.options-err")"; then
    printf 'build-shell-cli-lib: the launcher printed no options. %s\n' \
        "$(head -1 "$tmp.options-err")" >&2
    rm -rf "$tmp" "$tmp.options-err"
    exit 1
fi
rm -f "$tmp.options-err"

{
    printf '# key-type %s\n' "$key_type"
    printf '# node-id %s\n' "$node_id"
    printf '# core-port %s\n' "$CORE_PORT"
    printf '# core-mgmt-port %s\n' "$CORE_MGMT_PORT"
    printf '# java %s\n' "$java_path"
    # The proven stamp of the staged jar set. node-9/install copies these two
    # values into the .installed marker. See CHAT-gwrrazjg.
    printf '# source-commit %s\n' "$tree_commit"
    printf '# source-dirty %s\n' "$tree_dirty"
    printf '%s\n' "$options"
} > "$tmp/shell-cli.options"

chmod 644 "$tmp"/*.jar "$tmp/shell-cli.options" 2> /dev/null
chmod 755 "$tmp"
mv "$tmp" "$stage" || { rm -rf "$tmp"; fail "the stage does not move to $stage"; }

# The main class must stand on the staged classpath. A stage without it gives
# a ClassNotFoundError at the first run, so the check happens here.
# grep -c counts without an early exit, so unzip takes no SIGPIPE.
main_class_jars=0
for jar in "$stage"/*.jar; do
    count="$(unzip -l "$jar" 2> /dev/null | grep -c 'com/demo/chat/ShellCliKt.class')"
    (( count > 0 )) && main_class_jars=$(( main_class_jars + 1 ))
done
if (( main_class_jars == 0 )); then
    fail "no staged jar holds com/demo/chat/ShellCliKt.class. The stage at $stage is incomplete."
fi

jars="$(find "$stage" -maxdepth 1 -name '*.jar' | grep -c .)"
bytes="$(find "$stage" -maxdepth 1 -type f -exec wc -c {} + \
    | awk 'END { print $1 }')"
printf 'build-shell-cli-lib: %s jars, %s bytes in %s at commit %s, dirty %s\n' \
    "$jars" "$bytes" "$stage" "$tree_commit" "$tree_dirty"
