# profiles: client-backend,deploy,discovery-consul,jdbc,register-consul
--add-modules=jdk.incubator.vector
--enable-native-access=ALL-UNNAMED
-Dapp.client.discovery=consul
-Dapp.client.protocol=rsocket
-Dapp.client.rsocket.composite.user
-Dapp.client.rsocket.core.index
-Dapp.client.rsocket.core.key
-Dapp.client.rsocket.core.persistence
-Dapp.client.rsocket.core.secrets
-Dapp.key.type=long
-Dapp.nodeid=0
-Dapp.oauth2.entrypoint-path=localhost:9090
-Dapp.oauth2.jwk.path=file:/tmp/chat-build-golden.jwk
-Dapp.primary=authserv
-Dapp.rootkeys.required=false
-Dapp.rsocket.transport.security.type=unprotected
-Dapp.service.composite.auth
-Djava.security.egd=file:/dev/./urandom
-Dlogging.level.com.demo.chat.client.rsocket=DEBUG
-Dmanagement.endpoint.health.enabled=true
-Dmanagement.endpoint.shutdown.enabled=true
-Dmanagement.endpoints.web.exposure.include=shutdown,health
-Dmanagement.server.port=9001
-Dserver.port=9000
-Dspring-boot.run.arguments=--clientpath=classpath:client.json
-Dspring-boot.run.jvmArguments=
-Dspring.application.name=chat-authserv
-Dspring.autoconfigure.exclude=org.springframework.boot.autoconfigure.rsocket.RSocketServerAutoConfiguration
-Dspring.cloud.consul.discovery.enabled=true
-Dspring.cloud.consul.discovery.health-check-headers[0]=Authorization:
-Dspring.cloud.consul.discovery.preferIpAddress=true
-Dspring.cloud.consul.host=10.0.0.5
-Dspring.cloud.consul.port=8500
-Dspring.config.additional-location=classpath:/config/server-authserv-consul.yml,classpath:/config/oauth2-client.yml,classpath:/config/logging.yml,classpath:/config/management-defaults.yml,classpath:/config/client-rsocket-consul.yml
-Dspring.main.web-application-type=servlet
-Dspring.profiles.active=
-Dspring.security.user.name=actuator
-Dspring.security.user.password=actuator
-Dspring.security.user.roles=ACTUATOR
