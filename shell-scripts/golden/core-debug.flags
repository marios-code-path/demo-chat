# profiles: deploy,expose-rsocket,memory-backend
-Dapp.controller.index
-Dapp.controller.key
-Dapp.controller.message
-Dapp.controller.persistence
-Dapp.controller.pubsub
-Dapp.controller.secrets
-Dapp.controller.topic
-Dapp.controller.user
-Dapp.core.controllers=persistence,index,key,pubsub,secrets,user,topic,message
-Dapp.key.type=long
-Dapp.kv.store=none
-Dapp.primary=core-service
-Dapp.rootkeys.consume.scheme=http
-Dapp.rootkeys.consume.source=http://127.0.0.1:6791
-Dapp.server.proto=rsocket
-Dapp.service.composite
-Dapp.service.composite.auth
-Dapp.service.core.index=lucene
-Dapp.service.core.key=memory
-Dapp.service.core.persistence=memory
-Dapp.service.core.pubsub=memory
-Dapp.service.core.secrets=memory
-Djava.security.egd=file:/dev/./urandom
-Dlogging.level.io.rsocket.FrameLogger=DEBUG
-Dlogging.level.io.rsocket.FrameLogger=OFF
-Dmanagement.endpoint.health.enabled=true
-Dmanagement.endpoint.rootkeys.enabled=true
-Dmanagement.endpoint.shutdown.enabled=true
-Dmanagement.endpoints.web.exposure.include=shutdown,health,rootkeys
-Dmanagement.server.port=6791
-Dserver.port=6791
-Dspring-boot.run.arguments=
-Dspring-boot.run.jvmArguments=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005
-Dspring.application.name=core-service-rsocket
-Dspring.cloud.consul.config.enabled=false
-Dspring.cloud.consul.config.watch.enabled=false
-Dspring.cloud.consul.discovery.enabled=false
-Dspring.cloud.consul.enabled=false
-Dspring.cloud.service-registry.auto-registration.enabled=false
-Dspring.config.additional-location=classpath:/config/server-rsocket-consul.yml,classpath:/config/logging.yml,classpath:/config/management-defaults.yml
-Dspring.main.web-application-type=reactive
-Dspring.profiles.active=prod
-Dspring.rsocket.server.port=6790
-Dspring.rsocket.server.ssl.enabled=false
-Dspring.security.user.name=actuator
-Dspring.security.user.password=actuator
-Dspring.security.user.roles=ACTUATOR
