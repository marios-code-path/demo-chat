# profiles: client-backend,deploy,jdbc
--add-modules=jdk.incubator.vector
--enable-native-access=ALL-UNNAMED
-Dapp.client.discovery=properties
-Dapp.client.protocol=rsocket
-Dapp.client.rsocket.composite.user
-Dapp.client.rsocket.core.index
-Dapp.client.rsocket.core.key
-Dapp.client.rsocket.core.persistence
-Dapp.client.rsocket.core.secrets
-Dapp.client.rsocket.credential.username=Service
-Dapp.key.type=long
-Dapp.kv.store=none
-Dapp.nodeid=0
-Dapp.oauth2.agent-scope=chat.mcp
-Dapp.oauth2.agents[0].client-id=5b2c9e1a-3f47-4d8e-9a61-0c7d2e8f4b13
-Dapp.oauth2.agents[0].username=Agent
-Dapp.oauth2.agents[1].client-id=7c1e0b2a-5d0e-4c55-9d1e-2f6a8b3c4d5e
-Dapp.oauth2.agents[1].username=Claude
-Dapp.oauth2.entrypoint-path=localhost:9090
-Dapp.oauth2.jwk.path=file:/tmp/chat-build-golden.jwk
-Dapp.primary=authserv
-Dapp.rootkeys.required=false
-Dapp.rsocket.transport.security.type=unprotected
-Dapp.service.composite.auth=true
-Djava.security.egd=file:/dev/./urandom
-Dlogging.level.com.demo.chat.client.rsocket=DEBUG
-Dmanagement.endpoint.health.enabled=true
-Dmanagement.endpoint.shutdown.enabled=true
-Dmanagement.endpoints.web.exposure.include=shutdown,health
-Dmanagement.server.port=9001
-Dserver.port=9000
-Dspring-boot.run.arguments=
-Dspring-boot.run.jvmArguments=
-Dspring.application.name=chat-authserv
-Dspring.autoconfigure.exclude=org.springframework.boot.autoconfigure.rsocket.RSocketServerAutoConfiguration
-Dspring.cloud.consul.config.enabled=false
-Dspring.cloud.consul.config.watch.enabled=false
-Dspring.cloud.consul.discovery.enabled=false
-Dspring.cloud.consul.enabled=false
-Dspring.cloud.service-registry.auto-registration.enabled=false
-Dspring.config.additional-location=classpath:/config/server-authserv-consul.yml,classpath:/config/oauth2-client.yml,classpath:/config/logging.yml,classpath:/config/management-defaults.yml,classpath:/config/client-rsocket-local.yml
-Dspring.main.web-application-type=servlet
-Dspring.profiles.active=
-Dspring.security.user.name=actuator
-Dspring.security.user.password=actuator
-Dspring.security.user.roles=ACTUATOR
