# profiles: client-backend,deploy,discovery-consul,register-consul,shell
--add-modules=jdk.incubator.vector
--enable-native-access=ALL-UNNAMED
-Dapp.client.discovery=consul
-Dapp.client.protocol=rsocket
-Dapp.client.rsocket.composite.message
-Dapp.client.rsocket.composite.topic
-Dapp.client.rsocket.composite.user
-Dapp.client.rsocket.core.index
-Dapp.client.rsocket.core.key
-Dapp.client.rsocket.core.persistence
-Dapp.client.rsocket.core.pubsub
-Dapp.client.rsocket.core.secrets
-Dapp.key.type=long
-Dapp.kv.prefix=/chat
-Dapp.kv.rootkeys=rootkeys
-Dapp.kv.store=consul
-Dapp.nodeid=0
-Dapp.primary=shell
-Dapp.rootkeys.consume.scheme=kv
-Dapp.rsocket.transport.security.type=unprotected
-Dapp.service.composite.auth
-Dapp.service.core.key=memory
-Djava.security.egd=file:/dev/./urandom
-Dlogging.level.io.rsocket.FrameLogger=OFF
-Dmanagement.endpoint.health.enabled=true
-Dmanagement.endpoint.rootkeys.enabled=true
-Dmanagement.endpoint.shutdown.enabled=true
-Dmanagement.endpoints.web.exposure.include=shutdown,health,rootkeys
-Dmanagement.server.port=9101
-Dserver.port=9101
-Dspring-boot.run.arguments=
-Dspring-boot.run.jvmArguments=
-Dspring.application.name=chat-shell
-Dspring.autoconfigure.exclude=org.springframework.boot.autoconfigure.rsocket.RSocketServerAutoConfiguration
-Dspring.cloud.consul.discovery.enabled=true
-Dspring.cloud.consul.discovery.health-check-headers[0]=Authorization:
-Dspring.cloud.consul.discovery.preferIpAddress=true
-Dspring.cloud.consul.host=10.0.0.5
-Dspring.cloud.consul.port=8500
-Dspring.config.additional-location=classpath:/config/logging.yml,classpath:/config/management-defaults.yml,classpath:/config/client-rsocket-consul.yml
-Dspring.main.web-application-type=reactive
-Dspring.profiles.active=shell
-Dspring.security.user.name=actuator
-Dspring.security.user.password=actuator
-Dspring.security.user.roles=ACTUATOR
-Dspring.shell.interactive.enabled=true
