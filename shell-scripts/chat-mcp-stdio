#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${CHAT_MCP_LIB+x}" || -f "$script_dir/../.installed" ]]; then
    runtime_path="${CHAT_MCP_LIB-$script_dir/../lib/mcp}"
    lib_dir="$(cd "$runtime_path" 2>/dev/null && pwd -P)" || {
        printf 'chat-mcp-stdio: the MCP runtime is missing at %s.\n' "$runtime_path" >&2
        exit 1
    }
    mcp_jars=("$lib_dir"/*.jar)
    if [[ ! -f "${mcp_jars[0]}" ]]; then
        printf 'chat-mcp-stdio: the MCP runtime has no jars at %s.\n' "$runtime_path" >&2
        exit 1
    fi
    classpath="$(IFS=:; printf '%s' "${mcp_jars[*]}")"
else
    repo="${DEMO_CHAT_HOME:-$(cd "$script_dir/.." && pwd)}"
    classpath_file="$repo/chat-mcp/target/mcp-runtime.classpath"
    classes="$repo/chat-mcp/target/classes"
    if [[ ! -d "$classes" || ! -s "$classpath_file" ]]; then
        printf 'chat-mcp-stdio: run just build-mcp-stdio in %s first.\n' "$repo" >&2
        exit 1
    fi
    classpath="$classes:$(cat "$classpath_file")"
fi

if [[ "$#" -eq 0 && -z "${CHAT_MCP_CONFIG:-}" ]]; then
    printf 'chat-mcp-stdio: give --config PATH or set CHAT_MCP_CONFIG.\n' >&2
    exit 2
fi

exec "${CHAT_MCP_JAVA:-java}" -cp "$classpath" \
    com.demo.chat.mcp.McpAdapterMainKt "$@"
