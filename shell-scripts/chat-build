def profile_inputs() -> bool:
    """Read a selected profile without evaluating its records."""
    if "CHAT_NODE_PROFILE" not in os.environ:
        return False
    result = subprocess.run(
        ["bash", str(HERE / "node-profile")], capture_output=True, text=True)
    if result.returncode:
        sys.stderr.write(result.stderr)
        raise SystemExit(result.returncode)
    for record in result.stdout.split("\n"):
        if not record:
            continue
        key, separator, value = record.partition("=")
        if not separator:
            print("chat-build: the profile reader returned an invalid record.", file=sys.stderr)
            raise SystemExit(2)
        os.environ[key] = value
    for target, source in (("CORE_PORT", "NODE_RSOCKET_PORT"),
                           ("CORE_MGMT_PORT", "NODE_MGMT_PORT")):
        if target not in os.environ and source in os.environ:
            os.environ[target] = os.environ[source]
    if "CHAT_REGISTRY" not in os.environ and "NODE_REGISTRY_PORT" in os.environ:
        os.environ["CHAT_REGISTRY"] = "127.0.0.1:" + os.environ["NODE_REGISTRY_PORT"]
    return True


