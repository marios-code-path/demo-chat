def node_id_value(raw: str) -> int:
    """Parse --node-id. There is no default and no derivation."""
    try:
        value = int(raw)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"node id must be an integer in 0..1023, got {raw!r}")
    if value < 0 or value > 1023:
        raise argparse.ArgumentTypeError(
            f"node id must be an integer in 0..1023, got {value}")
    return value


def add_common_args(parser: argparse.ArgumentParser) -> None:
    profile_node = os.environ.get("NODE_ID") if PROFILE_INPUTS else None
    parser.add_argument("--node-id", metavar="ID", required=profile_node is None,
                        default=profile_node, type=node_id_value,
                        help="node id for key generation, an integer in 0..1023. "
                             "It must be unique across every deployment that writes to one store.")

    tls = parser.add_mutually_exclusive_group()
    tls.add_argument("--tls", metavar="DIR",
                     help="enable TLS using certificates in DIR")
    tls.add_argument("--notls", action="store_true",
                     help="disable TLS (required if --tls is not given)")

    goal = parser.add_mutually_exclusive_group()
    goal.add_argument("--run", action="store_true",
                      help="run locally via spring-boot:run (default)")
    goal.add_argument("--build", action="store_true",
                      help="build a container image via spring-boot:build-image")
    goal.add_argument("--agent-json", action="store_true",
                      help="authserv only: print the agent launch JSON and exit")
    parser.add_argument("--image-manifest", default=os.environ.get("CHAT_IMAGE_MANIFEST", ""),
                        metavar="PATH",
                        help="with --build, append the image to this JSON manifest. One path "
                             "serves one deployment run, and a later push reads the list. "
                             "CHAT_IMAGE_MANIFEST sets the default.")

    parser.add_argument("--init", default="", metavar="PHASES",
                        help="init phases, comma separated: users,rootkeys")
    parser.add_argument("--profile", action="append", default=[], metavar="NAME",
                        help="additional Spring profile (repeatable)")
    parser.add_argument("--env-file", metavar="PATH",
                        help="where to write the env file")
    parser.add_argument("--bake", action="store_true",
                        help="pass options via the env file instead of inheriting them")
    parser.add_argument("--native", action="store_true",
                        help="GraalVM native build (not supported)")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the resolved command and options, run nothing")
    parser.add_argument("--jwk", metavar="PATH",
                        help="path to the JWK file trusted by the deployment")
    parser.add_argument("--agent", action="append", default=[], metavar="CLIENT_ID=HANDLE",
                        help="an agent: the OAuth client id and the chat user handle. "
                             "Repeat it for each agent. authserv --build refuses it, "
                             "because an image must hold no agent identity")
    parser.add_argument("--agent-jwks-uri", action="append", default=[], metavar="CLIENT_ID=HTTPS_URI",
                        help="authserv only: public JWKS URI for one private_key_jwt agent")
    parser.add_argument("--index-root", metavar="DIR", default=None,
                        help="core only: keep the Lucene indexes in files under DIR, "
                             "an absolute path. Without it they stay in memory")
    parser.add_argument("--agent-scope", default="chat.mcp",
                        help="scope required by every agent token")
    # Both flags belong to the shell service. Every parser takes them, so
    # another service refuses them by name. See CHAT-yexqiyie.
    parser.add_argument("--registry", metavar="HOST:PORT", default="",
                        help="shell only: the Consul registry the client reads. "
                             "It selects consul discovery. CHAT_REGISTRY is the default")
    parser.add_argument("--core-id", metavar="ID", type=node_id_value, default=None,
                        help="shell only: the node id of the target core. "
                             "It needs --registry")
    # Removed by CHAT-frcrctdp. Kept hidden so that a launch that names them
    # fails with a message that names --agent.
    parser.add_argument("--agent-client-id", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--agent-username", default=None, help=argparse.SUPPRESS)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="chat-build",
        description="Compose and run demo-chat Maven builds from feature flags.",
        epilog="Example: chat-build core --memory --run --notls --key-type long --node-id 0 --init users,rootkeys",
    )
    subparsers = parser.add_subparsers(dest="service", required=True,
                                       metavar="SERVICE")
    for service in SERVICES.values():
        sub = subparsers.add_parser(service.name, help=service.description)
        add_common_args(sub)
        if service.name == "core":
            sub.add_argument("--index", choices=("cassandra", "lucene"),
                             help="index provider for a Cassandra core")
            sub.add_argument("--pubsub", choices=("memory", "redis-pubsub"),
                             help="pub/sub provider for a Cassandra core")
            sub.add_argument("--vector", choices=("embedded",),
                             help="embedded vector store for a Cassandra core")
            sub.add_argument("--embedding", choices=("openai",),
                             help="OpenAI-compatible embedding provider for a Cassandra core")
        # The choices are the keytype features, so --key-type and the feature
        # flags name the same key types. See CHAT-brlctoze.
        key_types = [n for n in service.available_features
                     if FEATURES[n].group == "keytype"]
        if key_types:
            sub.add_argument("--key-type", choices=key_types, metavar="TYPE",
                             help="key type: " + ", ".join(key_types)
                             + ". Same as the feature flag of that name.")
        group = sub.add_argument_group("features")
        for name in service.available_features:
            feat = FEATURES[name]
            suffix = ""
            if name == service.default_backend or name in service.default_features:
                suffix = " (default)"
            group.add_argument(f"--{name}", action="store_true",
                               help=feat.description + suffix)
            if feat.removable and name in service.default_features:
                group.add_argument(f"--no-{name}", action="store_true",
                                   help=f"leave out --{name}")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if (PROFILE_INPUTS and not getattr(args, "key_type", None)
            and not getattr(args, "long", False) and not getattr(args, "uuid", False)):
        args.key_type = os.environ.get("NODE_KEY_TYPE")

    # Every run and every image build is a deployment, and a deployment names
    # its key type. No key type is a default. See CHAT-ehpgyapa.
    key_types = [n for n in SERVICES[args.service].available_features
                 if FEATURES[n].group == "keytype"]
    if key_types and not (getattr(args, "key_type", None)
                          or any(getattr(args, n, False) for n in key_types)):
        print(f"chat-build: {args.service} needs a key type. Use --key-type TYPE with "
              f"{' or '.join(key_types)}. A launch and an image build have no default "
              f"key type.", file=sys.stderr)
        return 2

    # The shell names its registry and its target core. Another service has
    # no such option, and local discovery holds no node id. See CHAT-yexqiyie.
    if args.service != "shell":
        if args.registry:
            print("chat-build: --registry requires the shell service", file=sys.stderr)
            return 2
        if args.core_id is not None:
            print("chat-build: --core-id requires the shell service", file=sys.stderr)
            return 2
    else:
        if not args.registry:
            args.registry = os.environ.get("CHAT_REGISTRY", "")
        if args.registry:
            host, sep, port = args.registry.rpartition(":")
            if not sep or not host or not port.isdigit():
                print(f"chat-build: --registry takes HOST:PORT, got '{args.registry}'",
                      file=sys.stderr)
                return 2
            # A named registry is a consul registry, so it selects that
            # discovery mode. The caller needs no second flag.
            args.consul = True
        if args.core_id is not None and not args.registry:
            print("chat-build: --core-id needs --registry. Local discovery holds no "
                  "node id.", file=sys.stderr)
            return 2

    if args.service == "core" and (args.index or args.pubsub) and not args.cassandra:
        print("chat-build: --index and --pubsub require --cassandra", file=sys.stderr)
        return 1

    if args.service == "core" and bool(args.vector) != bool(args.embedding):
        print("chat-build: --vector and --embedding must be set together", file=sys.stderr)
        return 2
    if args.service == "core" and args.vector and not args.cassandra:
        print("chat-build: --vector and --embedding require --cassandra", file=sys.stderr)
        return 2

    if args.native:
        print("chat-build: native builds are not supported at this time",
              file=sys.stderr)
        return 1

    if not args.tls and not args.notls:
        print("chat-build: specify --tls <dir> or --notls", file=sys.stderr)
        return 1

    if args.tls and not os.environ.get("KEYSTORE_PASS"):
        print("chat-build: KEYSTORE_PASS must be set when using --tls",
              file=sys.stderr)
        return 1

    # The mode prints the mapping and exits. It comes before the --jwk rules,
    # because it starts no server and needs no signing key. See CHAT-vidnpywh.
    if args.agent_json:
        if args.service != "authserv":
            print("chat-build: --agent-json requires the authserv service",
                  file=sys.stderr)
            return 1
        if not args.agent:
            print("chat-build: --agent-json needs at least one --agent. "
                  "The mode prints the agent mapping, and an empty mapping names nothing.",
                  file=sys.stderr)
            return 1
        json_agents = parse_agents(args.agent)
        print(agent_launch_json(
            json_agents,
            parse_agent_jwks(args.agent_jwks_uri, args.service, json_agents),
            args.agent_scope))
        return 0

    if args.service == "authserv":
        # --build bakes the launch options into the image, and a host path
        # would not exist inside a container. So the key is required to run
        # and refused for an image. An operator supplies it at docker run.
        if args.build and args.jwk:
            print("chat-build: --jwk cannot be baked into an image. "
                  "A host path does not exist inside the container. "
                  "Supply app.oauth2.jwk.path when you run the image.",
                  file=sys.stderr)
            return 1
        # An agent mapping names a runtime identity, and the image build writes
        # it into the image environment. One image would then serve one agent
        # set. --agent-json prints the mapping, and the deployment passes it at
        # launch. See CHAT-vidnpywh.
        if args.build and (args.agent or args.agent_jwks_uri):
            print("chat-build: --agent cannot be baked into an image. "
                  "An agent mapping names a runtime identity, not a build input. "
                  "Print it with 'chat-build authserv --agent-json', and pass the "
                  "result through AUTHSERV_AGENTS_JSON when you start the image.",
                  file=sys.stderr)
            return 1
        if not args.build and not args.jwk:
            print("chat-build: --jwk PATH is required to run the "
                  "authorization server. It reads an ES256 signing key from "
                  "app.oauth2.jwk.path, and there is no default. "
                  "See docs/BUILD.md for how to make one.",
                  file=sys.stderr)
            return 1
        if args.jwk:
            jwk = Path(args.jwk).expanduser()
            # Absolute, because spring-boot:run sets the module directory as
            # the working directory. A relative path would resolve against
            # that rather than against the caller.
            if not jwk.is_absolute():
                print(f"chat-build: --jwk must be an absolute path: {args.jwk}",
                      file=sys.stderr)
                return 1
            if not jwk.is_file():
                print(f"chat-build: --jwk names no file: {args.jwk}",
                      file=sys.stderr)
                return 1

    # Compare with None. An empty value such as --agent-client-id= is still a
    # use of a removed flag.
    if args.agent_client_id is not None or args.agent_username is not None:
        print("chat-build: --agent-client-id and --agent-username are removed. "
              "Use --agent CLIENT_ID=HANDLE. See CHAT-frcrctdp.", file=sys.stderr)
        return 2

    if args.agent:
        if args.service not in ("rest", "core", "authserv"):
            print("chat-build: --agent requires the core, rest or authserv service",
                  file=sys.stderr)
            return 1
        parse_agents(args.agent)
        if args.service in ("rest", "core"):
            if not args.jwk:
                print("chat-build: --agent requires --jwk PATH", file=sys.stderr)
                return 1
            jwk = Path(args.jwk).expanduser()
            if not jwk.is_absolute():
                print(f"chat-build: --jwk must be an absolute path: {args.jwk}",
                      file=sys.stderr)
                return 1
            if not jwk.is_file():
                print(f"chat-build: --jwk names no file: {args.jwk}",
                      file=sys.stderr)
                return 1

    # Compare with None. An empty value such as --index-root= is refused, and
    # not read as no root. See CHAT-eesnvnad.
    if args.index_root is not None:
        if args.service != "core":
            print("chat-build: --index-root requires the core service. "
                  "Only the core holds the Lucene indexes", file=sys.stderr)
            return 1
        if not args.index_root:
            print("chat-build: --index-root must not be empty", file=sys.stderr)
            return 1
        if args.cassandra and args.index != "lucene":
            print("chat-build: --index-root has no effect with --cassandra. "
                  "The Cassandra backend uses the Cassandra index, not Lucene",
                  file=sys.stderr)
            return 1
        if args.build:
            print("chat-build: --index-root cannot be baked into an image. "
                  "A host path does not exist inside the container. "
                  "Mount a volume and supply app.index.lucene.root when you "
                  "run the image", file=sys.stderr)
            return 1
        # Expand ~ first, then check. The directory may be absent, because
        # the index start creates it. Absolute, because spring-boot:run sets
        # the module directory as the working directory.
        if not Path(args.index_root).expanduser().is_absolute():
            print(f"chat-build: --index-root must be an absolute path: "
                  f"{args.index_root}", file=sys.stderr)
            return 1

    ctx = BuildContext(SERVICES[args.service], args)

    if args.dry_run:
        cmd = ctx.compose_maven_command()
        print(f"# service:  {ctx.service.name}")
        print(f"# module:   {ctx.module_dir()}")
        print(f"# features: {' '.join(sorted(ctx.selected))}")
        print(f"# image:    {ctx.image_name}")
        print()
        print("# maven command:")
        print(" ".join(shlex.quote(c) for c in cmd))
        print()
        print("# JAVA_TOOL_OPTIONS:")
        for flag in ctx.java_tool_options_list():
            print(f"  {flag}")
        print()
        print(f"# env file would be written to: {ctx.env_file_path()}")
        return 0

    return ctx.execute()


if __name__ == "__main__":
    sys.exit(main())
