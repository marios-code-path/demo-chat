AGENT_HANDLE = re.compile(r"[A-Za-z0-9_]+")
# Admin and Anon are the ChatIdentity names. Service is the default service
# account. An agent must be a plain user. See CHAT-frcrctdp.
RESERVED_AGENT_HANDLES = ("Admin", "Anon", "Service")


def parse_agents(values: list[str]) -> list[tuple[str, str]]:
    """Parse each --agent value. Exit 1 with a message on a refused value."""
    agents: list[tuple[str, str]] = []
    reserved = {name.lower() for name in RESERVED_AGENT_HANDLES}
    for value in values:
        client_id, sep, handle = value.partition("=")
        if not sep or not client_id or not handle:
            raise SystemExit(f"chat-build: --agent takes CLIENT_ID=HANDLE: {value}")
        if not AGENT_HANDLE.fullmatch(handle):
            raise SystemExit(
                f"chat-build: --agent handle '{handle}' must hold letters, digits and underscores alone")
        if handle.lower() in reserved:
            raise SystemExit(f"chat-build: --agent names reserved handle '{handle}'. "
                             "An agent must be a plain user")
        if any(client_id == c for c, _ in agents):
            raise SystemExit(f"chat-build: --agent names client id '{client_id}' twice")
        if any(handle.lower() == h.lower() for _, h in agents):
            raise SystemExit(f"chat-build: --agent names handle '{handle}' twice")
        agents.append((client_id, handle))
    return agents


def parse_agent_jwks(values: list[str] | None, service_name: str,
                     agents: list[tuple[str, str]]) -> dict[str, str]:
    """Parse each --agent-jwks-uri value. Exit 1 with a message on a refused value."""
    jwks: dict[str, str] = {}
    registered = dict(agents)
    for value in values or []:
        if service_name != "authserv":
            raise SystemExit("chat-build: --agent-jwks-uri requires authserv")
        client_id, separator, uri = value.partition("=")
        try:
            parsed_uri = urlsplit(uri)
            valid_uri = (parsed_uri.scheme == "https" and parsed_uri.hostname is not None
                         and parsed_uri.username is None and parsed_uri.password is None
                         and not parsed_uri.fragment and not any(char.isspace() for char in uri))
        except ValueError:
            valid_uri = False
        if not separator or not client_id or not valid_uri:
            raise SystemExit("chat-build: --agent-jwks-uri needs CLIENT_ID=HTTPS_URI")
        if client_id in jwks or client_id not in registered:
            raise SystemExit("chat-build: --agent-jwks-uri needs one registered agent client id")
        jwks[client_id] = uri
    return jwks


def agent_launch_json(agents: list[tuple[str, str]], jwks: dict[str, str],
                      scope: str) -> str:
    """The launch JSON of the agent properties. See CHAT-vidnpywh.

    The deployment passes this object as SPRING_APPLICATION_JSON. That source
    ranks above the JVM system properties that an image bakes, and a launch
    list replaces a baked list. So the image holds no agent identity.
    """
    entries: list[dict[str, str]] = []
    for client_id, handle in agents:
        entry = {"client-id": client_id, "username": handle}
        if client_id in jwks:
            entry["jwk-set-uri"] = jwks[client_id]
        entries.append(entry)
    return json.dumps({"app": {"oauth2": {"agents": entries, "agent-scope": scope}}},
                      indent=2, sort_keys=True)


class BuildContext:
    """Resolves features against a service and composes the Maven invocation."""

    def __init__(self, service: Service, args: argparse.Namespace):
        self.service = service
        self.args = args
        self.selected = self._resolve_features()
        self.backend = self._resolve_backend()
        # The key type is the selected feature of the keytype group, so
        # --key-type and the feature flags agree. See CHAT-brlctoze.
        # main() refuses a launch with no key type, so one is always selected.
        self.key_type = next(n for n in self.selected if FEATURES[n].group == "keytype")
        self.node_id = args.node_id
        self.discovery = "consul" if "consul" in self.selected else "local"
        self.init_phases = [p.strip() for p in (args.init or "").split(",") if p.strip()]
        self.tls_dir: str | None = args.tls
        self.jwk_path: str | None = getattr(args, "jwk", None)
        self.agents: list[tuple[str, str]] = parse_agents(getattr(args, "agent", []) or [])
        self.agent_jwks: dict[str, str] = parse_agent_jwks(
            getattr(args, "agent_jwks_uri", []), self.service.name, self.agents)
        self.agent_scope: str = getattr(args, "agent_scope", "chat.mcp")
        # Expanded and never resolved, for the reason given at the --jwk flag.
        # main() refuses an empty or relative value. See CHAT-eesnvnad.
        index_root = getattr(args, "index_root", None)
        self.index_root: str | None = (
            str(Path(index_root).expanduser()) if index_root else None)
        self.image_name = service.image_name_for(self.backend)

    # -- resolution ------------------------------------------------------

    def _resolve_features(self) -> list[str]:
        # --key-type TYPE selects the keytype feature TYPE. It comes first, so a
        # conflict with a feature flag names --key-type's value first.
        key_type = getattr(self.args, "key_type", None)
        chosen = [key_type] if key_type else []
        chosen += [
            name for name in self.service.available_features
            if getattr(self.args, name.replace("-", "_"), False)
            and name not in chosen
        ]
        for name in self.service.default_features:
            if FEATURES[name].removable and self._removed(name):
                if name in chosen:
                    sys.exit(f"chat-build: --{name} conflicts with --no-{name}")
                continue
            if name not in chosen and not self._group_taken(chosen, name):
                chosen.append(name)

        for name in chosen:
            for other in FEATURES[name].conflicts:
                if other in chosen:
                    sys.exit(f"chat-build: --{name} conflicts with --{other}")

        seen: dict[str, str] = {}
        for name in chosen:
            group = FEATURES[name].group
            if group in (None, "backend"):
                continue
            if group in seen and seen[group] != name:
                sys.exit(
                    f"chat-build: --{name} and --{seen[group]} are both "
                    f"'{group}' options; pick one"
                )
            seen[group] = name
        return chosen

    def _removed(self, name: str) -> bool:
        return getattr(self.args, "no_" + name.replace("-", "_"), False)

    def _group_taken(self, chosen: list[str], candidate: str) -> bool:
        group = FEATURES[candidate].group
        if group is None:
            return False
        return any(FEATURES[c].group == group for c in chosen)

    def _resolve_backend(self) -> str:
        picked = [n for n in self.selected if FEATURES[n].group == "backend"]
        if len(picked) > 1:
            sys.exit(
                "chat-build: pick exactly one backend, got "
                + ", ".join(f"--{p}" for p in picked)
            )
        if picked:
            return picked[0]
        default = self.service.default_backend
        self.selected.append(default)
        return default

    def _features(self) -> list[Feature]:
        return [FEATURES[n] for n in self.selected]

    # -- Maven -----------------------------------------------------------

    def maven_profiles(self) -> list[str]:
        profiles = ["deploy"]
        profiles += list(self.service.maven_profiles)
        for feat in self._features():
            profiles += feat.maven_profiles
        if self.discovery == "consul" and self.service.client_proto:
            profiles.append("discovery-consul")
        # Preserve order, drop duplicates.
        return list(dict.fromkeys(profiles))

    def spring_profiles(self) -> list[str]:
        profiles: list[str] = []
        for feat in self._features():
            profiles += feat.spring_profiles
        profiles += self.args.profile
        return list(dict.fromkeys(profiles))

    def maven_goal(self) -> str:
        return "spring-boot:build-image" if self.args.build else "spring-boot:run"

    def module_dir(self) -> Path:
        return REPO_ROOT / self.module_name()

    def module_name(self) -> str:
        """The selected backend's module wins over the service default."""
        for feat in self._features():
            if feat.module:
                return feat.module
        return self.service.module

    def compose_maven_command(self) -> list[str]:
        return [
            "mvn",
            f"-DimageName={self.image_name}",
            "-P" + ",".join(self.maven_profiles()),
            # Skip test compilation too. spring-boot:run forks the
            # test-compile lifecycle, and -DskipTests does not stop
            # that compilation. A stale local repository then breaks a
            # launch in test classes. B7, fp issue CHAT-uxmjaebs.
            "-Dmaven.test.skip=true",
            self.maven_goal(),
        ]

    # -- JAVA_TOOL_OPTIONS groups, in build-app.sh order -----------------

    def endpoint_flags(self) -> list[str]:
        endpoints = list(self.service.management_endpoints)
        if self.args.service == "core" and self.args.vector:
            endpoints.append("vectorindex")
        if self.discovery == "consul" and "health" not in endpoints:
            endpoints.append("health")
        if not endpoints:
            return []
        flags = [f"-Dmanagement.endpoint.{e}.enabled=true" for e in endpoints]
        flags.append("-Dmanagement.endpoints.web.exposure.include=" + ",".join(endpoints))
        return flags

    def main_flags(self) -> list[str]:
        flags = [
            NATIVE_ACCESS_FLAG,
            VECTOR_API_MODULE_FLAG,
            f"-Dspring.profiles.active={','.join(self.spring_profiles())}",
        ]
        flags += self.endpoint_flags()
        flags += [
            f"-Dapp.key.type={self.key_type}",
            f"-Dapp.nodeid={self.node_id}",
            f"-Dapp.primary={self.service.app_primary}",
            f"-Dspring.application.name={self.service.deployment_name}",
            "-Djava.security.egd=file:/dev/./urandom",
        ]
        if self.jwk_path and self.service.name == "authserv":
            # Emitted as given, after ~ expansion, and never resolved.
            # resolve() rewrites /tmp to /private/tmp on macOS and leaves it
            # alone on Linux, which would make the golden flags differ by
            # operating system. The argument check requires an absolute path,
            # so nothing here needs to make one.
            flags.append(
                "-Dapp.oauth2.jwk.path=file:"
                + str(Path(self.jwk_path).expanduser())
            )
        if self.index_root:
            # The Lucene indexes keep their files under this directory. Without
            # it they stay in memory. See docs/LUCENE-INDEX-FILES.md.
            flags.append(f"-Dapp.index.lucene.root={self.index_root}")
        for feat in self._features():
            for key, value in feat.spring_properties.items():
                if key.startswith("app.service.core."):
                    continue  # emitted in service_flags, which owns the defaults
                flags.append(f"-D{key}={value}")
        return flags

    def agent_flags(self) -> list[str]:
        """The agent properties of each service. See CHAT-frcrctdp."""
        if not self.agents:
            return []
        if self.service.name == "authserv":
            flags = []
            for i, (client_id, handle) in enumerate(self.agents):
                flags += [f"-Dapp.oauth2.agents[{i}].client-id={client_id}",
                          f"-Dapp.oauth2.agents[{i}].username={handle}"]
                if client_id in self.agent_jwks:
                    flags.append(f"-Dapp.oauth2.agents[{i}].jwk-set-uri={self.agent_jwks[client_id]}")
            return flags + [f"-Dapp.oauth2.agent-scope={self.agent_scope}"]
        flags = []
        if self.service.name == "core":
            # The bracket form keeps each map key. Without brackets, relaxed
            # binding can give two entries one handle value.
            for _, handle in self.agents:
                flags += [f"-Dapp.init.initial-users[{handle}].handle={handle}",
                          f"-Dapp.init.initial-users[{handle}].name={handle}",
                          f"-Dapp.init.initial-users[{handle}].image-uri=chatimg://agent.png"]
        for i, (client_id, handle) in enumerate(self.agents):
            flags += [f"-Dapp.security.agents[{i}].client-id={client_id}",
                      f"-Dapp.security.agents[{i}].username={handle}"]
        return flags + [f"-Dapp.security.required-scope={self.agent_scope}",
                        f"-Dapp.security.jwt.jwk-path={self.jwk_path}"]

    def tls_flags(self) -> list[str]:
        """Server TLS for services, client TLS for client-shaped services.

        build-app.sh branches on whether CLIENT_FLAGS is set; this mirrors that.
        """
        is_client = bool(self.service.client_flags)
        if self.tls_dir is None:
            if is_client and self.service.client_proto == "rsocket":
                return ["-Dapp.rsocket.transport.security.type=unprotected"]
            return ["-Dspring.rsocket.server.ssl.enabled=false"]

        keystore_pass = os.environ.get("KEYSTORE_PASS", "")
        if is_client and self.service.client_proto == "rsocket":
            return [
                "-Dapp.rsocket.transport.security.type=pkcs12",
                f"-Dapp.rsocket.transport.security.truststore.path={self.tls_dir}/client_truststore.p12",
                f"-Dapp.rsocket.transport.security.keystore.path={self.tls_dir}/client_keystore.p12",
                f"-Dapp.rsocket.transport.security.keyfile.pass={keystore_pass}",
            ]
        return [
            "-Dspring.rsocket.server.ssl.enabled=true",
            "-Dspring.rsocket.server.ssl.client-auth=none",
            "-Dspring.rsocket.server.ssl.protocol=TLS",
            "-Dspring.rsocket.server.ssl.enabled-protocols=TLSv1.2",
            f"-Dspring.rsocket.server.ssl.key-store={self.tls_dir}/server_keystore.p12",
            "-Dspring.rsocket.server.ssl.key-store-type=PKCS12",
            f"-Dspring.rsocket.server.ssl.key-store-password={keystore_pass}",
        ]

    def ports_flags(self) -> list[str]:
        return self.service.port_flags()

    def init_flags(self) -> list[str]:
        flags: list[str] = []
        if "users" in self.init_phases:
            flags.append("-Dapp.users.create=true")
        # The root key role of the service decides the flags. RootKeySource in
        # chat-deploy refuses any other combination at start.
        role = self.service.root_keys
        if role == "store":
            # This node reaches its store. It loads or creates the roots, so no
            # flag creates them. The "rootkeys" phase publishes them to Consul.
            if self.discovery == "consul" and "rootkeys" in self.init_phases:
                flags += [
                    "-Dapp.kv.store=consul",
                    "-Dapp.kv.prefix=/chat",
                    "-Dapp.kv.rootkeys=rootkeys",
                    "-Dapp.rootkeys.publish.scheme=kv",
                ]
        elif role == "consume" and self.discovery == "consul":
            # This client has no store. It reads the snapshot that a store node
            # published to Consul KV.
            flags += [
                "-Dapp.kv.store=consul",
                "-Dapp.kv.prefix=/chat",
                "-Dapp.kv.rootkeys=rootkeys",
                "-Dapp.rootkeys.consume.scheme=kv",
            ]
        elif role == "consume":
            # This client has no store. It reads the snapshot from the actuator
            # of a store node.
            flags += [
                "-Dapp.kv.store=none",
                "-Dapp.rootkeys.consume.scheme=http",
                f"-Dapp.rootkeys.consume.source={ROOTKEY_SOURCE_URI}",
            ]
        elif role == "none":
            flags.append("-Dapp.rootkeys.required=false")
            if self.discovery == "local":
                flags.append("-Dapp.kv.store=none")
        else:
            raise SystemExit(f"chat-build: unknown root key role '{role}' for {self.service.name}")
        return flags

    def discovery_flags(self) -> list[str]:
        actuator_user = [
            "-Dspring.security.user.name=actuator",
            "-Dspring.security.user.password=actuator",
            "-Dspring.security.user.roles=ACTUATOR",
        ]
        if self.discovery == "consul":
            # --registry names the registry. Without it, the launch looks for a
            # consul container. See CHAT-yexqiyie.
            registry = getattr(self.args, "registry", "")
            if registry:
                host, _, port = registry.rpartition(":")
                consul_port = int(port)
            else:
                host = os.environ.get("CONSUL_HOST") or find_consul_host()
                consul_port = CONSUL_PORT
            flags = [
                f"-Dspring.cloud.consul.host={host}",
                f"-Dspring.cloud.consul.port={consul_port}",
                "-Dspring.cloud.consul.discovery.enabled=true",
                "-Dspring.cloud.consul.discovery.preferIpAddress=true",
                "-Dspring.cloud.consul.discovery.health-check-headers[0]="
                "'Authorization: Basic QXV0aG9yaXphdGlvbjogQmFzaWMg'",
            ] + actuator_user
            if self.service.client_proto:
                flags.append("-Dapp.client.discovery=consul")
            core_id = getattr(self.args, "core_id", None)
            if core_id is not None:
                flags.append(f"-Dapp.client.discovery.core-id={core_id}")
            return flags

        flags = [
            "-Dspring.cloud.consul.enabled=false",
            "-Dspring.cloud.service-registry.auto-registration.enabled=false",
            "-Dspring.cloud.consul.config.enabled=false",
            "-Dspring.cloud.consul.config.watch.enabled=false",
            "-Dspring.cloud.consul.discovery.enabled=false",
        ] + actuator_user
        if self.service.client_proto:
            flags.append("-Dapp.client.discovery=properties")
        return flags

    def client_flags(self) -> list[str]:
        flags = list(self.service.client_flags)
        if flags and "websocket" in self.selected:
            flags.append("-Dapp.rsocket.transport.websocket.enabled=true")
        return flags

    def service_flags(self) -> list[str]:
        flags = list(self.service.service_flags)
        if self.args.service == "core" and self.args.vector:
            flags.extend([
                f"-Dapp.service.core.vector={self.args.vector}",
                f"-Dapp.service.core.embedding={self.args.embedding}",
                "-Dapp.controller.recall=true",
            ])
        for feat in self._features():
            flags += feat.service_flags
        # A feature that names a backend for any app.service.core.* selector
        # replaces the default. Later features win, matching profile order.
        selectors: dict[str, str] = {}
        for feat in self._features():
            for key, value in feat.spring_properties.items():
                if key.startswith("app.service.core."):
                    selectors[key] = value
        if self.service.name == "core":
            if self.args.index:
                selectors["app.service.core.index"] = self.args.index
            if self.args.pubsub:
                selectors["app.service.core.pubsub"] = self.args.pubsub
        for key, value in selectors.items():
            prefix = f"-D{key}"
            flags = [
                f"{prefix}={value}"
                if f == prefix or f.startswith(prefix + "=") else f
                for f in flags
            ]
        if flags and "websocket" in self.selected:
            flags += [
                "-Dspring.rsocket.server.transport=websocket",
                "-Dspring.rsocket.server.mapping-path=/",
            ]
        return flags

    def additional_configs(self) -> list[str]:
        # Order is load order, and later locations win in Spring. build-app.sh
        # appends the base pair onto whatever the run script exported, so
        # service and feature configs come first and the base overrides them.
        configs = list(self.service.additional_configs)
        for feat in self._features():
            configs += feat.additional_configs
        configs += BASE_ADDITIONAL_CONFIGS
        if "users" in self.init_phases:
            configs.append("classpath:/config/userinit.yml")
        if self.service.client_proto:
            configs.append(
                f"classpath:/config/client-{self.service.client_proto}-{self.discovery}.yml"
            )
        return list(dict.fromkeys(configs))

    def opt_flags(self) -> list[str]:
        flags = list(self.service.opt_flags)
        for feat in self._features():
            flags += feat.opt_flags
        if "debug" in self.selected:
            flags.append("-Dlogging.level.io.rsocket.FrameLogger=DEBUG")
            if self.service.client_proto:
                flags += [
                    "-Dlogging.level.com.demo.chat.client.rsocket=DEBUG",
                    "-Dlogging.level.reactor.netty.http.client=DEBUG",
                ]
        flags.append(
            "-Dspring.config.additional-location=" + ",".join(self.additional_configs())
        )
        return flags

    def run_args(self) -> list[str]:
        jvm_args = ""
        if "debug" in self.selected and not self.args.build:
            suspend = os.environ.get("DEBUG_SUSPEND", "n")
            jvm_args = (
                f"-agentlib:jdwp=transport=dt_socket,server=y,"
                f"suspend={suspend},address={DEBUG_PORT}"
            )
        return [
            f'-Dspring-boot.run.arguments="{self.service.run_arguments}"',
            f'-Dspring-boot.run.jvmArguments="{jvm_args}"',
        ]

    def java_tool_options_list(self) -> list[str]:
        groups = [
            self.main_flags(),
            self.tls_flags(),
            self.ports_flags(),
            self.init_flags(),
            self.discovery_flags(),
            self.client_flags(),
            self.service_flags(),
            self.agent_flags(),
            self.opt_flags(),
            self.run_args(),
        ]
        return [flag for group in groups for flag in group]

    def java_tool_options(self) -> str:
        return " ".join(self.java_tool_options_list())

    # -- output ----------------------------------------------------------

    def env_file_path(self) -> Path:
        if self.args.env_file:
            return Path(self.args.env_file)
        return Path(f"/tmp/chat-build-{self.service.name}-{self.image_name}.env")

    def env_file_content(self) -> str:
        """Real KEY=VALUE pairs.

        build-app.sh wrote literal `echo KEY = VALUE` lines here, which docker
        --env-file cannot parse. This emits something docker can actually read.
        """
        return "\n".join([
            f"JAVA_TOOL_OPTIONS={self.java_tool_options()}",
            "MAVEN_PROFILES=-P" + ",".join(self.maven_profiles()),
            f"MAVEN_GOAL={self.maven_goal()}",
            f"CWD={self.module_dir()}",
            f"IMAGE_NAME={self.image_name}",
        ]) + "\n"

    def write_env_file(self) -> Path:
        path = self.env_file_path()
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(self.env_file_content())
        return path

    def image_reference(self, env: dict[str, str]) -> str:
        """The image reference of this module, as the POM composes it.

        Some modules read ${image.repo}; others use fixed image names.
        chat-deploy has a shell resolver for its launch path. This path asks
        Maven for the effective POM value used by build-image.
        """
        cmd = [
            "mvn",
            "-B",
            "-ntp",
            "-q",
            f"-DimageName={self.image_name}",
            "-P" + ",".join(self.maven_profiles()),
            "-DforceStdout",
            "-Dexpression=appImageName",
            "help:evaluate",
        ]
        answer = subprocess.run(cmd, cwd=self.module_dir(), env=env,
                                capture_output=True, text=True)
        if answer.returncode != 0:
            return ""
        reference = answer.stdout.strip().splitlines()[-1].strip() if answer.stdout.strip() else ""
        if reference == "null" or "${" in reference:
            return ""
        return reference

    def record_image(self, env: dict[str, str]) -> int:
        """Append this build's image to the manifest. Return 0 on success.

        The record holds the reference, the image id, and the architecture.
        The repository digest is optional, because a local image holds none
        until a push gives it one. The write replaces a record of the same
        reference, and it reaches the file in one rename. See CHAT-jmnjvupr.
        """
        path = Path(self.args.image_manifest).expanduser()
        reference = self.image_reference(env)
        if not reference:
            print("chat-build: the module reports no image name, so the manifest "
                  "takes no record.", file=sys.stderr)
            return 1
        inspect = subprocess.run(
            ["docker", "image", "inspect", "--format", "{{json .}}", reference],
            capture_output=True, text=True)
        if inspect.returncode != 0:
            print(f"chat-build: docker holds no image {reference}, so the manifest "
                  f"takes no record.", file=sys.stderr)
            return 1
        try:
            details = json.loads(inspect.stdout.strip().splitlines()[0])
        except (json.JSONDecodeError, IndexError):
            print(f"chat-build: the image query of {reference} gives no JSON object.",
                  file=sys.stderr)
            return 1
        if (not isinstance(details, dict)
                or not isinstance(details.get("Id"), str)
                or not details["Id"]
                or not isinstance(details.get("Architecture"), str)
                or not details["Architecture"]):
            print(f"chat-build: the image query of {reference} has no image id "
                  "or architecture.", file=sys.stderr)
            return 1
        record = {
            "reference": reference,
            "imageId": details.get("Id", ""),
            "architecture": details.get("Architecture", ""),
            "service": self.service.name,
            "module": str(self.module_dir().name),
        }
        digests = details.get("RepoDigests") or []
        # A colon before the last slash belongs to a registry port.
        repository = (reference.rsplit(":", 1)[0]
                      if ":" in reference.rsplit("/", 1)[-1] else reference)
        if isinstance(digests, list):
            matching = next((digest for digest in digests
                             if isinstance(digest, str)
                             and digest.startswith(repository + "@")), None)
            if matching:
                record["digest"] = matching
        path.parent.mkdir(parents=True, exist_ok=True)
        # One lock holds the read, the change, and the write. Two builds can
        # share one manifest of a deployment run, and an unlocked pair loses
        # records: six parallel builds left two. The lock file stays beside the
        # manifest. See CHAT-jmnjvupr.
        lock_path = path.with_name(path.name + ".lock")
        with open(lock_path, "a+") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            try:
                records = []
                if path.is_file():
                    try:
                        text = path.read_text()
                        earlier = json.loads(text) if text.strip() else []
                    except (json.JSONDecodeError, UnicodeDecodeError):
                        print(f"chat-build: {path} holds no UTF-8 JSON, so the manifest "
                              f"takes no record. The file stays as it is.",
                              file=sys.stderr)
                        return 1
                    # A JSON value of another type is somebody else's file.
                    # The build refuses it, and it changes nothing.
                    if not isinstance(earlier, list):
                        print(f"chat-build: {path} holds a JSON "
                              f"{type(earlier).__name__}, and a manifest is a list. "
                              f"The file stays as it is.", file=sys.stderr)
                        return 1
                    if any(not isinstance(item, dict)
                           or not isinstance(item.get("reference"), str)
                           or not item["reference"]
                           or any(char.isspace() for char in item["reference"])
                           for item in earlier):
                        print(f"chat-build: {path} holds an invalid image record. "
                              "The file stays as it is.", file=sys.stderr)
                        return 1
                    records = [r for r in earlier
                               if r["reference"] != reference]
                records.append(record)
                # The stage file carries a unique name, so two writers never
                # share one path, and the rename reaches the manifest whole.
                handle, stage_name = tempfile.mkstemp(dir=str(path.parent),
                                                      prefix=path.name + ".")
                try:
                    with os.fdopen(handle, "w") as stage:
                        stage.write(json.dumps(records, indent=2, sort_keys=True) + "\n")
                    os.replace(stage_name, path)
                finally:
                    Path(stage_name).unlink(missing_ok=True)
            finally:
                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)
        print(f"chat-build: {reference} reaches {path}", file=sys.stderr)
        return 0

    def execute(self) -> int:
        env_file = self.write_env_file()
        print(f"ENV_FILE={env_file}", file=sys.stderr)

        env = os.environ.copy()
        if self.args.bake:
            # The image build reads the env file instead of inheriting options.
            env.pop("JAVA_TOOL_OPTIONS", None)
        else:
            env["JAVA_TOOL_OPTIONS"] = self.java_tool_options()

        cmd = self.compose_maven_command()
        print("+ " + " ".join(shlex.quote(c) for c in cmd), file=sys.stderr)
        status = subprocess.run(cmd, cwd=self.module_dir(), env=env).returncode
        # The manifest takes a record after the build passes alone. A failed
        # build produces no image, so it names nothing to push.
        if status == 0 and self.args.build and self.args.image_manifest:
            try:
                return self.record_image(env)
            except OSError as error:
                print(f"chat-build: image manifest failed: {error}", file=sys.stderr)
                return 1
        return status


def find_consul_host() -> str:
    """Mirror util.sh find_consul: locate a running consul container's IP."""
    try:
        cid = subprocess.run(
            ["docker", "ps", "-aqf", "name=consul"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        cid = ""
    if not cid:
        sys.exit(
            "chat-build: no consul container found and CONSUL_HOST is unset.\n"
            "Run consul in docker, or set CONSUL_HOST and CONSUL_PORT."
        )
    ip = subprocess.run(
        ["docker", "inspect", "-f",
         "{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}", cid],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    return ip or CONSUL_HOST


