#!/usr/bin/env bash
# Runs one chat-shell command in a new JVM and exits with its status.
#
#   CHAT_SHELL_KEY_TYPE=uuid shell-scripts/chat-shell-cli messages lobby --format records
#
# The words are the command line. Text for a command, such as the entry for
# post, goes on standard input. Run just build-shell-cli first.
#
# Settings, all from the environment:
#   CHAT_SHELL_KEY_TYPE      required, long or uuid, and it must match the core
#   CHAT_SHELL_NODE_ID       default 1
#   CORE_PORT, CORE_MGMT_PORT  the core, as chat-build reads them
#   CHAT_SHELL_USER, CHAT_SHELL_PASSWORD_FILE  the login, both or neither
#   CHAT_SHELL_LOG           a file for the log, which is off otherwise
#   CHAT_SHELL_CLI_PRINT_OPTIONS=1  print the JVM options and end
#   CHAT_SHELL_LAUNCH_EPOCH_MS  the launch time for a hard limit. The script sets it when it is absent.
#
# The exit status is 0 for success. The other statuses are in the design of
# the topic register, section "chat-shell as a command tool", part 2.
set -euo pipefail

# The launch time counts toward the hard limit of register-read, so the JVM start and this
# script count too. A caller can set the stamp. CHAT_SHELL_LAUNCH_EPOCH_MS is in milliseconds.
: "${CHAT_SHELL_LAUNCH_EPOCH_MS:=$(perl -MTime::HiRes=time -e 'printf "%d", time * 1000')}"
export CHAT_SHELL_LAUNCH_EPOCH_MS

# A command with a hard limit runs under a supervisor from the launch of the script. The JVM has a
# watchdog too, but it cannot stop a stall before Java starts, such as a stuck chat-build. The
# supervisor runs this script again as a child in its own process group. At the limit it ends the
# whole group, writes one line on standard error, and exits with 124. The limits repeat HardLimits
# in Kotlin, and LaunchDeadlineTests checks that they agree. The code stays valid for bash 3.2.
limit_ms=
case "${1:-}" in
    register-read) limit_ms=30000 ;;
esac
if [[ -n "$limit_ms" && -z "${CHAT_SHELL_SUPERVISED:-}" ]]; then
    limit_line="chat-shell: $1 passed its ${limit_ms} ms limit"
    remaining="$(perl -MTime::HiRes=time -e 'printf "%.3f", ($ARGV[0] - (time * 1000 - $ARGV[1])) / 1000' \
        "$limit_ms" "$CHAT_SHELL_LAUNCH_EPOCH_MS")"
    if [[ "$remaining" == -* || "$remaining" == 0.000 ]]; then
        echo "$limit_line" >&2
        exit 124
    fi
    expired="$(mktemp -t chat-shell-cli)"
    rm -f "$expired"
    child_err="$(mktemp -t chat-shell-cli-err)"
    # The supervisor owns standard error. The child can write its own limit line at the same moment as
    # the timer, and a timeout must leave exactly one line. So the child writes to a file. At the end
    # the supervisor prints its line alone after a timeout, and it passes the file on after any other end.
    # perl makes each process its own group leader, so one kill ends the child and all it started.
    # The explicit input redirection keeps standard input, which a background job would lose.
    perl -e 'setpgrp(0, 0); exec @ARGV' env CHAT_SHELL_SUPERVISED=1 "${BASH_SOURCE[0]}" "$@" <&0 2> "$child_err" &
    child=$!
    perl -e 'setpgrp(0, 0); exec @ARGV' bash -c '
        sleep "$1"
        : > "$2"
        kill -TERM -- "-$3" 2>/dev/null
        sleep 1
        kill -KILL -- "-$3" 2>/dev/null' timer "$remaining" "$expired" "$child" > /dev/null 2>&1 &
    timer=$!
    status=0
    wait "$child" || status=$?
    # The timer ends by a signal, so its wait returns non-zero, and set -e must not stop the script here.
    kill -TERM -- "-$timer" 2>/dev/null || true
    wait "$timer" 2>/dev/null || true
    if [[ -e "$expired" ]]; then
        rm -f "$expired" "$child_err"
        echo "$limit_line" >&2
        exit 124
    fi
    cat "$child_err" >&2
    rm -f "$child_err"
    exit "$status"
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
key_type="${CHAT_SHELL_KEY_TYPE:?set CHAT_SHELL_KEY_TYPE to long or uuid}"
node_id="${CHAT_SHELL_NODE_ID:-1}"
classpath="$root/chat-deploy/target/shell-cli.classpath"

# The options of the shell launch plan, as chat-build prints them for the
# interactive shell. They go on the java command line, not in
# JAVA_TOOL_OPTIONS, because the JVM prints a line on standard error for that
# variable.
plan="$("$root/shell-scripts/chat-build" shell --run --notls --node-id "$node_id" \
    --key-type "$key_type" --dry-run)"
opts=()
while IFS= read -r line; do
    case "$line" in
        # The vector module makes the JVM print a warning on standard error, and a shell client needs no vectors.
        --add-modules=jdk.incubator.vector) ;;
        -Dspring.shell.interactive.enabled=*|-Dspring-boot.run.*) ;;
        *) opts+=("$line") ;;
    esac
done < <(sed -nE 's/^  +((-D|--)[^ ].*)$/\1/p' <<< "$plan")

# These come last, so they win over the plan.
opts+=(
    -Dchat.shell.mode=one-shot
    -Dspring.shell.interactive.enabled=false
    -Dspring.main.banner-mode=off
    -Dlogging.threshold.console=OFF
    -Dspring.main.web-application-type=none
    --sun-misc-unsafe-memory-access=allow
)
if [[ -n "${CHAT_SHELL_LOG:-}" ]]; then
    opts+=("-Dlogging.file.name=$CHAT_SHELL_LOG")
fi

# CHAT_SHELL_CLI_PRINT_OPTIONS=1 prints the JVM options, one on each line, and ends.
# The native proof reads them to set the AOT properties of its build.
if [[ "${CHAT_SHELL_CLI_PRINT_OPTIONS:-}" == 1 ]]; then
    printf '%s\n' "${opts[@]}"
    exit 0
fi
if [[ ! -s "$classpath" ]]; then
    echo "chat-shell-cli: no classpath file. Run just build-shell-cli first." >&2
    exit 1
fi

exec java "${opts[@]}" -cp "$root/chat-deploy/target/classes:$(cat "$classpath")" \
    com.demo.chat.ShellCliKt "$@"
