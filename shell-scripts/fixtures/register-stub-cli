#!/usr/bin/env bash
# A stub chat shell CLI for the offline import tests. See CHAT-jmnjvupr.
#
# The stub keeps its whole state in files under $STUB_STATE, so two states
# stand for two hosts. It answers the calls that the importer makes:
#
#   whoami
#   register-read --index <room>
#   add-topic --name <topic>
#   join <topic>
#   post --topic <topic> [--requestId <id>]      Text comes from standard in.
#   messages <topic> --format records
#
# A repeated --requestId returns the first message ID and stores no second
# message. That rule makes a retry safe.
#
# Failure switches:
#   STUB_NO_CORE=1            Every call exits 69 and logs nothing.
#   STUB_REGISTER=<name>      The index room name. Default demo-chat-register.
#   STUB_DENY_INDEX=1         A read of the index gives a denied warning.
#   STUB_INDEX_PRE=<n>        The index starts with n messages.
#   STUB_FAIL_AFTER_POST=<n>  The nth post stores its message, then exits 75.
#   STUB_STALL_READ=1         Every read sleeps past every test budget.
#   STUB_STALL_SECONDS=<n>    The length of that sleep. Default 120.
#   STUB_READ_SLEEP=<seconds> Every read waits that long.
#   STUB_DENY_TOPIC=1         A topic read gives a denied warning and exits 0.
set -uo pipefail

state="${STUB_STATE:?Set STUB_STATE}"
# The index room carries the register name. A read names its room with
# --index. See CHAT-jmnjvupr.
register_room="${STUB_REGISTER:-demo-chat-register}"
mkdir -p "$state/messages" "$state/requests" "$state/joins"
[[ -f "$state/count" ]] || printf '0\n' > "$state/count"
[[ -f "$state/posts" ]] || printf '0\n' > "$state/posts"
[[ -f "$state/owner" ]] || printf 'Mario\n' > "$state/owner"
# Record the core ports of each call, so a test can prove pass-through.
printf 'CORE_PORT=%s CORE_MGMT_PORT=%s\n' "${CORE_PORT-}" "${CORE_MGMT_PORT-}" \
    >> "$state/ports.log"
# Record the caller login of each call, so a test can prove that the caller
# reaches the core. A create without a login leaves a room that no user owns.
if [[ -r "${CHAT_SHELL_PASSWORD_FILE:-}" ]]; then
    password_state='readable'
else
    password_state='absent'
fi
printf '%s %s %s %s\n' "${CHAT_SHELL_USER-}" "${CHAT_SHELL_KEY_TYPE-}" \
    "${CHAT_SHELL_NODE_ID-}" "$password_state" >> "$state/login.log"

if [[ "${STUB_NO_CORE:-0}" == '1' ]]; then
    printf 'stub: the core is not available\n' >&2
    exit 69
fi

printf '%s\n' "$*" >> "$state/log"

# next_id  Print one new message ID and keep the counter.
next_id() {
    local count
    count="$(cat "$state/count")"
    count=$((count + 1))
    printf '%s\n' "$count" > "$state/count"
    printf 'msg-%06d\n' "$count"
}

# record TOPIC ID TEXT_FILE  Print one record line for a message.
record() {
    local topic="$1" id="$2" text_file="$3" stamp
    stamp="2026-10-22T00:00:00.${id#msg-}Z"
    jq -cS -n --arg topic "$topic" --arg id "$id" --arg stamp "$stamp" \
        --rawfile text "$text_file" \
        '{type: "record", id: $id, topic: $topic, timestamp: $stamp,
          text: $text}'
}

# post_receipt ID REQUEST_ID  Print the shape of the installed post result.
post_receipt() {
    local id="$1" request_id="$2"
    jq -cS -n --arg message "$id" --arg request "$request_id" \
        --arg command "cmd-$id" \
        '{messageId: $message, commandId: $command,
          requestId: $request, outcome: "ACCEPTED"}'
}

# seed_index  Put STUB_INDEX_PRE messages into the index on first use.
seed_index() {
    local want="${STUB_INDEX_PRE:-0}" index=0 id
    [[ "$want" =~ ^[0-9]+$ ]] || want=0
    [[ -f "$state/seeded" ]] && return 0
    : > "$state/seeded"
    (( want == 0 )) && return 0
    printf '%s\n' "$register_room" >> "$state/topics"
    for (( index = 0; index < want; index++ )); do
        id="$(next_id)"
        printf 'seed %s\n' "$index" > "$state/seed-text"
        record "$register_room" "$id" "$state/seed-text" \
            >> "$state/messages/$register_room.jsonl"
    done
    rm -f "$state/seed-text"
}

seed_index

command_name="${1:-}"
shift || true

case "$command_name" in
    whoami)
        printf '91da3ce0-cda6-11f1-bae2-25daa21d179d : %s | MARIO OWNER | chatimg://mario.png\n' \
            "${CHAT_SHELL_USER:-}"
        exit 0
        ;;
    register-read)
        index=''
        while (( $# )); do
            case "$1" in
                --index)
                    index="${2:-}"
                    shift 2 || true
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        if [[ -z "$index" ]]; then
            printf 'stub: register-read needs --index\n' >&2
            exit 2
        fi
        if [[ "${STUB_STALL_READ:-0}" == '1' ]]; then
            sleep "${STUB_STALL_SECONDS:-120}"
            exit 0
        fi
        [[ -n "${STUB_READ_SLEEP:-}" ]] && sleep "$STUB_READ_SLEEP"
        if [[ "${STUB_DENY_INDEX:-0}" == '1' ]]; then
            jq -cS -n '{type: "warning", warning: "denied-index"}'
            exit 0
        fi
        if [[ ! -f "$state/topics" ]] \
              || ! grep -qx "$index" "$state/topics"; then
            printf 'stub: no room has the name %s\n' "$index" >&2
            exit 1
        fi
        if [[ "${CHAT_SHELL_USER:-}" != 'Mario' ]] \
              && ! grep -qx "${CHAT_SHELL_USER:-} $index" \
                  "$state/joins/all" 2> /dev/null; then
            jq -cS -n --arg topic "$index" \
                '{type: "warning", kind: "denied-index",
                  topic: $topic, reason: "Access Denied"}'
            exit 0
        fi
        [[ -f "$state/messages/$index.jsonl" ]] \
            && cat "$state/messages/$index.jsonl"
        exit 0
        ;;
    add-topic)
        topic=''
        while (( $# )); do
            case "$1" in
                --name)
                    topic="${2:-}"
                    shift 2 || true
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        [[ -n "$topic" ]] || { printf 'stub: add-topic needs --name\n' >&2; exit 2; }
        if [[ -f "$state/topics" ]] && grep -qx "$topic" "$state/topics"; then
            printf 'stub: the topic %s exists\n' "$topic" >&2
            exit 1
        fi
        printf '%s\n' "$topic" >> "$state/topics"
        jq -cS -n --arg topic "$topic" '{type: "topic", name: $topic}'
        exit 0
        ;;
    join)
        topic="${1:-}"
        [[ -n "$topic" ]] || { printf 'stub: join needs a topic\n' >&2; exit 2; }
        printf '%s %s\n' "${CHAT_SHELL_USER:-}" "$topic" >> "$state/joins/all"
        jq -cS -n --arg topic "$topic" --arg user "${CHAT_SHELL_USER:-}" \
            '{type: "join", name: $topic, user: $user}'
        exit 0
        ;;
    post)
        topic=''
        request_id=''
        while (( $# )); do
            case "$1" in
                --topic)
                    topic="${2:-}"
                    shift 2 || true
                    ;;
                --requestId)
                    request_id="${2:-}"
                    shift 2 || true
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        [[ -n "$topic" ]] || { printf 'stub: post needs --topic\n' >&2; exit 2; }
        cat > "$state/last-post"
        # A post that once stayed uncertain stays uncertain while the switch
        # holds. The message is stored, so a later run finds it by its
        # request ID and makes no second message.
        if [[ -n "$request_id" && -f "$state/uncertain/$request_id" \
              && "${STUB_FAIL_AFTER_POST:-0}" != '0' ]]; then
            printf 'stub: the post outcome is uncertain\n' >&2
            exit 75
        fi
        if [[ -n "$request_id" && -f "$state/requests/$request_id" ]]; then
            id="$(cat "$state/requests/$request_id")"
            post_receipt "$id" "$request_id"
            exit 0
        fi
        id="$(next_id)"
        record "$topic" "$id" "$state/last-post" \
            >> "$state/messages/$topic.jsonl"
        [[ -n "$request_id" ]] && printf '%s\n' "$id" \
            > "$state/requests/$request_id"
        posts="$(cat "$state/posts")"
        posts=$((posts + 1))
        printf '%s\n' "$posts" > "$state/posts"
        fail_after="${STUB_FAIL_AFTER_POST:-0}"
        [[ "$fail_after" =~ ^[0-9]+$ ]] || fail_after=0
        if (( fail_after > 0 )) && (( posts == fail_after )); then
            mkdir -p "$state/uncertain"
            [[ -n "$request_id" ]] && : > "$state/uncertain/$request_id"
            printf 'stub: the post outcome is uncertain\n' >&2
            exit 75
        fi
        post_receipt "$id" "$request_id"
        exit 0
        ;;
    messages)
        topic="${1:-}"
        [[ -n "$topic" ]] || { printf 'stub: messages needs a topic\n' >&2; exit 2; }
        if [[ "${STUB_STALL_READ:-0}" == '1' ]]; then
            sleep "${STUB_STALL_SECONDS:-120}"
            exit 0
        fi
        [[ -n "${STUB_READ_SLEEP:-}" ]] && sleep "$STUB_READ_SLEEP"
        if [[ "${STUB_DENY_INDEX:-0}" == '1' && "$topic" == "$register_room" ]]; then
            jq -cS -n '{type: "warning", warning: "denied-index"}'
            exit 0
        fi
        if [[ "${STUB_DENY_TOPIC:-0}" == '1' ]]; then
            jq -cS -n --arg topic "$topic" \
                '{type: "warning", warning: "denied-topic", topic: $topic}'
            exit 0
        fi
        [[ -f "$state/messages/$topic.jsonl" ]] \
            && cat "$state/messages/$topic.jsonl"
        exit 0
        ;;
    *)
        printf 'stub: the command %s is unknown\n' "$command_name" >&2
        exit 2
        ;;
esac
