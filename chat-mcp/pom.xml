<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.demo</groupId>
        <artifactId>chat-parent</artifactId>
        <version>0.0.1</version>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>chat-mcp</artifactId>
    <version>0.0.1</version>
    <name>chat-mcp</name>
    <description>Standalone stdio MCP adapter for Demo Chat</description>

    <!-- The adapter speaks REST to a deployment. It holds no chat-core
         dependency and no store credential. See CHAT-dduyriqf and
         docs/superpowers/specs/2026-09-27-demo-chat-mcp-design.md. -->
    <dependencies>
        <!-- The SDK is declared as the JVM variant. Maven reads a POM and
             not the Gradle module metadata. Both versions come from the
             parent dependencyManagement. -->
        <dependency>
            <groupId>io.modelcontextprotocol</groupId>
            <artifactId>kotlin-sdk-server-jvm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol</groupId>
            <artifactId>kotlin-sdk-core-jvm</artifactId>
        </dependency>
        <!-- Declared directly. No chat-core dependency supplies them here. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-serialization-json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-coroutines-core</artifactId>
        </dependency>
        <!-- StdioServerTransport takes a kotlinx.io Source and Sink. The
             adapter names both types, so it declares the library. -->
        <dependency>
            <groupId>org.jetbrains.kotlinx</groupId>
            <artifactId>kotlinx-io-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- `McpAdapterHarnessTests` drives the pinned Node client, and that client
         is a package under `node_modules/`, which git ignores. A cold checkout
         therefore has no client, and CI run 36635977431 failed both jobs on a
         missing `@modelcontextprotocol/sdk`. This profile installs the client
         exactly when that directory is absent, so an ordinary build makes no
         network call and stays safe offline. `npm ci` keeps the committed lock
         file authoritative. A missing npm fails the build, because a silent
         skip would hide the loss of the stdout purity gate. CHAT-vkqdeoct. -->
    <profiles>
        <profile>
            <id>install-pinned-mcp-client</id>
            <activation>
                <file>
                    <missing>src/test/client/node_modules</missing>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>npm-ci</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${project.basedir}/src/test/client</workingDirectory>
                                    <executable>npm</executable>
                                    <arguments>
                                        <argument>ci</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
