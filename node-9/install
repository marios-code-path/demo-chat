#!/usr/bin/env bash
# Install node 9 outside the source tree. See CHAT-mvvvnujw.
#
#   install [--prefix DIR] [--import-state DIR] [--dry-run]
#
# DIR defaults to /opt/demo-chat/node-9. The installer copies code files and
# writes the .installed marker. It creates data/, secrets/ and images/ when
# they are missing. A re-run replaces code files alone. It never reads,
# writes, or deletes data/, secrets/, secrets.env, or images/.
#
# The installer refuses a prefix inside a git work tree. It refuses a
# non-empty prefix that has no marker.
#
# --import-state DIR copies secrets.env and secrets/ from the node-9
# directory DIR into a new home. It never overwrites a file. It skips the
# import and names the gap when DIR holds an incomplete set. It never copies
# Cassandra data.
set -uo pipefail

src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
prefix=/opt/demo-chat/node-9
import_dir=''
dry_run=false
skip_cli=false

# The Java floor of the shell CLI runtime. pom.xml sets the same value.
java_floor=25

usage() {
    printf 'usage: install [--prefix DIR] [--import-state DIR] [--dry-run] [--skip-cli]\n'
}

fail() {
    printf 'node-9 install: %s\n' "$1" >&2
    exit "${2:-1}"
}

while (( $# )); do
    case "$1" in
        --prefix)
            [[ $# -ge 2 && -n "$2" ]] || fail '--prefix needs a directory.' 2
            prefix="$2"
            shift
            ;;
        --import-state)
            [[ $# -ge 2 && -n "$2" ]] || fail '--import-state needs a directory.' 2
            import_dir="$2"
            shift
            ;;
        --dry-run) dry_run=true ;;
        --skip-cli) skip_cli=true ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; fail "unknown argument: $1" 2 ;;
    esac
    shift
done

[[ "$prefix" == /* ]] || fail "the prefix must be an absolute path, got '$prefix'." 2

# The code files. The installer itself stays in the source tree.
code_files=(node-9.env compose.yaml compose.vector-disk.yaml userinit.yml advertise.yml)
code_dirs=(bin schema ansible)
# The state names. A re-run never touches them.
state_dirs=(data secrets images)

# nearest_existing PATH  Print the nearest ancestor of PATH that exists.
nearest_existing() {
    local dir="$1"
    while [[ ! -d "$dir" ]]; do
        dir="$(dirname "$dir")"
    done
    (cd "$dir" && pwd -P)
}

# Refuse a prefix inside a git work tree.
anchor="$(nearest_existing "$prefix")"
if git -C "$anchor" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "the prefix $prefix is inside the git work tree $(git -C "$anchor" rev-parse --show-toplevel). Node 9 must stay outside every source tree." 2
fi

# Refuse a non-empty prefix that has no marker.
if [[ -d "$prefix" && ! -f "$prefix/.installed" ]] \
   && [[ -n "$(ls -A "$prefix")" ]]; then
    fail "$prefix is not empty and has no .installed marker." 2
fi

# complete_state DIR  Print the first gap in DIR, or nothing if it is complete.
complete_state() {
    local dir="$1" key name
    [[ -f "$dir/secrets.env" ]] || { printf 'secrets.env is missing'; return; }
    for key in CHAT_SERVICE_PASSWORD CHAT_ADMIN_PASSWORD \
               CHAT_EMBEDDING_OPENAI_API_KEY CHAT_USER_SIGMA_PASSWORD \
               CHAT_USER_THETA_PASSWORD CHAT_USER_PHI_PASSWORD; do
        grep -q "^$key=." "$dir/secrets.env" \
            || { printf '%s is missing from secrets.env' "$key"; return; }
    done
    for name in Sigma Theta Phi; do
        [[ -s "$dir/secrets/$name.password" ]] \
            || { printf 'secrets/%s.password is missing' "$name"; return; }
    done
}

# NODE9_JAVA names the java of the version check. The build script writes the
# same java into the frozen options, so the installed launcher runs it.
# NODE9_MVN names the mvn of the build. The build script gives a named java to
# Maven through JAVA_HOME, so one name selects the build JDK and the run JDK.
# A run that names no java keeps the JAVA_HOME of the caller. The offline suite
# points both names at an absent command.
java_command="${NODE9_JAVA:-java}"
mvn_command="${NODE9_MVN:-mvn}"

# A java that answers nothing holds the install. The stub at /usr/bin/java does
# that when JAVA_HOME names no JDK, so the version probe takes a time limit.
# NODE9_JAVA_LIMIT sets the seconds, and the offline suite lowers it. The build
# script reads the same name. See CHAT-faqxupam.
java_limit_s="${NODE9_JAVA_LIMIT:-30}"
probe_lib="$src/../shell-scripts/java-probe.sh"
[[ -f "$probe_lib" ]] \
    || fail 'no java-probe.sh script beside the node-9 directory.' 2
# shellcheck source=../shell-scripts/java-probe.sh
. "$probe_lib"

# The shell CLI runtime needs Java. The check runs before every copy, so a
# host without Java keeps its earlier home and takes no partial one. See
# CHAT-bjqzvsoe.
java_version='skipped'
if [[ "$skip_cli" != 'true' ]]; then
    command -v "$java_command" > /dev/null 2>&1 \
        || fail "no java at $java_command. The shell CLI runtime needs Java $java_floor. Install Java, or pass --skip-cli." 2
    java_text="$(java_probe_run "$java_limit_s" "$java_command" -version)"
    java_probe_status=$?
    (( java_probe_status != 124 )) \
        || fail "the java at $java_command gave no version inside the $java_limit_s second time limit. Check JAVA_HOME." 2
    java_version="$(printf '%s' "$java_text" \
        | sed -nE 's/.*version "([0-9]+).*/\1/p' | head -1)"
    [[ -n "$java_version" ]] \
        || fail 'cannot read the java version. The shell CLI runtime needs a readable version.' 2
    (( java_version >= java_floor )) \
        || fail "java $java_version is at $java_command, and the shell CLI runtime needs Java $java_floor." 2
    command -v "$mvn_command" > /dev/null 2>&1 \
        || fail "no mvn at $mvn_command. The install builds the shell CLI runtime from source." 2
    [[ -x "$src/../shell-scripts/build-shell-cli-lib" ]] \
        || fail 'no build-shell-cli-lib script beside the node-9 directory.' 2
fi

if [[ "$dry_run" == 'true' ]]; then
    printf 'prefix: %s\n' "$prefix"
    printf 'code: %s %s\n' "${code_files[*]}" "${code_dirs[*]}"
    printf 'java: %s\n' "$java_version"
    if [[ "$skip_cli" == 'true' ]]; then
        printf 'lib: skipped\n'
    else
        printf 'lib: one build of the jar set from %s\n' \
            "$(cd "$src/.." && pwd)"
    fi
    printf 'state kept: %s secrets.env\n' "${state_dirs[*]}"
    if [[ -n "$import_dir" ]]; then
        gap="$(complete_state "$import_dir")"
        printf 'import: %s\n' "${gap:-complete}"
    fi
    exit 0
fi

umask 022

# The jar set is built before any copy. A failed build then leaves the
# earlier home whole, with its code, its jar set, and its marker. The stage
# sits beside the prefix, so one rename completes it.
lib_stage=''
if [[ "$skip_cli" != 'true' ]]; then
    stage_parent="$(mktemp -d "$(dirname "$prefix")/.node9-install-XXXXXX")" \
        || fail 'no temporary directory for the jar set.' 1
    lib_stage="$stage_parent/lib"
    # The build takes the same two names that the check read, so the check and
    # the call never name two pairs. See the branch review of 2026-10-22.
    #
    # A name travels only when the caller set it. An earlier version passed
    # NODE9_JAVA on every run, so a default install named the java of the path.
    # The build script then replaced the JAVA_HOME of the caller with a derived
    # path, and the build held one core and printed no line. See CHAT-faqxupam.
    build_env=()
    [[ -n "${NODE9_JAVA:-}" ]] && build_env+=("NODE9_JAVA=$java_command")
    [[ -n "${NODE9_MVN:-}" ]] && build_env+=("NODE9_MVN=$mvn_command")
    if ! env "${build_env[@]+"${build_env[@]}"}" \
        "$src/../shell-scripts/build-shell-cli-lib" "$lib_stage" \
        > "$stage_parent/build.log" 2>&1; then
        printf 'node-9 install: the shell CLI build failed. Its log is at %s\n' \
            "$stage_parent/build.log" >&2
        exit 1
    fi
    printf 'node-9 install: %s\n' "$(tail -1 "$stage_parent/build.log")"
    rm -f "$stage_parent/build.log"
fi

mkdir -p "$prefix" || fail "cannot create $prefix." 1

# Replace the code. A directory is replaced whole, so a removed file goes.
for file in "${code_files[@]}"; do
    cp "$src/$file" "$prefix/$file" || fail "cannot copy $file." 1
done
for dir in "${code_dirs[@]}"; do
    rm -rf "${prefix:?}/$dir"
    cp -R "$src/$dir" "$prefix/$dir" || fail "cannot copy $dir." 1
done
cp "$src/../shell-scripts/chat-shell-cli" "$prefix/bin/chat-shell-cli" \
    || fail 'cannot copy the shell CLI launcher.' 1
rm -f "$prefix/ansible/vault/owner.yml"
chmod 755 "$prefix"/bin/*

# The jar set replaces the earlier one whole, so a dependency that left the
# build leaves the home. lib/ is code, not state.
#
# The earlier set moves aside first, and it returns when the new set cannot
# take its place. So a failed move leaves a working runtime. No rename can
# replace a directory that holds files, so the two renames leave one short
# window. A failure inside that window restores the earlier set.
# NODE9_INSTALL_FAIL_LIB_MOVE is a test hook of the offline suite.
# See the branch review of 2026-10-22.
if [[ -n "$lib_stage" ]]; then
    old_lib=''
    if [[ -d "$prefix/lib" ]]; then
        old_lib="$stage_parent/lib.old"
        mv "$prefix/lib" "$old_lib" \
            || fail "cannot move the earlier jar set out of $prefix/lib." 1
    fi
    if [[ "${NODE9_INSTALL_FAIL_LIB_MOVE:-}" == '1' ]] \
       || ! mv "$lib_stage" "$prefix/lib"; then
        if [[ -n "$old_lib" ]]; then
            mv "$old_lib" "$prefix/lib" \
                || fail "the jar set of $prefix/lib is lost. Run the install again." 1
            printf 'node-9 install: the new jar set did not move. The earlier set stays.\n' >&2
        fi
        fail "cannot move the jar set to $prefix/lib." 1
    fi
    rm -rf "$old_lib"
    rmdir "$stage_parent" 2> /dev/null
fi

# The owner Vault stays beside the home, in <parent>/vault/owner.yml.
owner_vault="$(dirname "$prefix")/vault/owner.yml"
if [[ -f "$owner_vault" ]]; then
    ln -s "$owner_vault" "$prefix/ansible/vault/owner.yml"
fi

# State directories. Create alone. Never change a present one.
for dir in "${state_dirs[@]}"; do
    [[ -d "$prefix/$dir" ]] && continue
    mkdir -p "$prefix/$dir"
    case "$dir" in
        secrets) chmod 700 "$prefix/$dir" ;;
    esac
done

# Import a complete set of secrets. Never overwrite.
if [[ -n "$import_dir" ]]; then
    gap="$(complete_state "$import_dir")"
    if [[ -n "$gap" ]]; then
        printf 'node-9 install: import skipped, %s. Start from scratch.\n' "$gap" >&2
    else
        if [[ ! -e "$prefix/secrets.env" ]]; then
            cp "$import_dir/secrets.env" "$prefix/secrets.env"
            chmod 600 "$prefix/secrets.env"
        fi
        for file in "$import_dir"/secrets/*; do
            [[ -f "$file" ]] || continue
            target="$prefix/secrets/$(basename "$file")"
            [[ -e "$target" ]] && continue
            cp "$file" "$target"
            chmod 600 "$target"
        done
        printf 'node-9 install: imported secrets from %s\n' "$import_dir"
    fi
fi

# The marker goes last. Its presence means the copy is complete.
{
    printf 'installed-at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'source-commit: %s\n' \
        "$(git -C "$src" rev-parse HEAD 2>/dev/null || printf unknown)"
    # The line reports the home, not the flag. --skip-cli on a home that
    # already holds a jar set keeps that set, and a reader of "skipped" would
    # otherwise expect no runtime. See the branch review of 2026-10-22.
    if [[ -n "$lib_stage" ]]; then
        printf 'cli: lib, java %s\n' "$java_version"
    elif [[ -f "$prefix/lib/shell-cli.options" ]]; then
        printf 'cli: lib, kept\n'
    else
        printf 'cli: skipped\n'
    fi
} > "$prefix/.installed"

printf 'node-9 install: installed in %s\n' "$prefix"
