#!/usr/bin/env bash
# Install node 9 outside the source tree. See CHAT-mvvvnujw and CHAT-cnwkjsrp.
#
#   install [--prefix DIR] [--dry-run] [--skip-cli]
#           (--vault-source DIR | --import-state DIR
#            | --local-secrets | --keep-secrets)
#
# DIR defaults to /opt/demo-chat/node-9. Exactly one secrets choice is
# required, so every install states where its secret state comes from.
#
#   --vault-source DIR  copy vault-pass, shared.yml and owner.yml from a
#                       complete bundle. The vaults stay outside the home,
#                       under <parent of prefix>/vault/. The installed
#                       playbook paths link to them. Plaintext setup stays
#                       pending; the run prints both setup-secrets commands.
#   --import-state DIR  copy a complete plaintext secrets.env and secrets/.
#                       The set must hold seven keys, three agent files, and
#                       each file must equal its key value.
#   --local-secrets     generate new local values during the install. The
#                       owner password needs a terminal. No vault is created,
#                       and the values are not reproducible after loss.
#   --keep-secrets      keep complete existing state on a reinstall. It
#                       changes no secret or vault file.
#
# The installer copies code files and writes the .installed marker last. It
# creates data/, secrets/ and images/ when they are missing. It never
# deletes data/, secrets/, secrets.env or a stable vault file.
#
# The installer refuses a prefix inside a git work tree. It refuses a
# non-empty prefix that has no marker. It refuses a symlink at a stable
# vault file or at the vault password.
set -uo pipefail

src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/secrets-local.sh
. "$src/bin/secrets-local.sh"
prefix=/opt/demo-chat/node-9
choice=''
vault_source=''
import_state=''
dry_run=false
skip_cli=false

# The Java floor of the shell CLI runtime. pom.xml sets the same value.
java_floor=25

# The last shared vault artifact that Git tracked. A home from the earlier
# layout holds a copy of it inside ansible/. It carries no active state when
# its bytes match. A different file is a real vault and a conflict.
# The two hooks let the offline suite test the rule without storing
# ciphertext in the repository. See CHAT-cnwkjsrp.
legacy_shared_sha256="${NODE9_INSTALL_LEGACY_SHA256:-eb0eee7dbcdcdbbcb79112bef6fafa405717abf89be229ed5aefc345ddb628ed}"
legacy_shared_size="${NODE9_INSTALL_LEGACY_SIZE:-1463}"

usage() {
    printf 'usage: install [--prefix DIR] [--dry-run] [--skip-cli]\n' >&2
    printf '       (--vault-source DIR | --import-state DIR | --local-secrets | --keep-secrets)\n' >&2
}

# choice_error  Name the four choices. The count check calls it.
choice_error() {
    printf 'node-9 install: give exactly one secrets choice.\n' >&2
    printf '  --vault-source DIR  copy a complete per-host vault bundle\n' >&2
    printf '  --import-state DIR  copy a complete plaintext secrets set\n' >&2
    printf '  --local-secrets     generate new local values during install\n' >&2
    printf '  --keep-secrets      keep complete state on a reinstall\n' >&2
}

# set_choice NAME  Record one choice. A second choice stops with status 2.
set_choice() {
    if [[ -n "$choice" ]]; then
        choice_error
        exit 2
    fi
    choice="$1"
}

fail() {
    printf 'node-9 install: %s\n' "$1" >&2
    exit "${2:-1}"
}

while (( $# )); do
    case "$1" in
        --prefix)
            [[ $# -ge 2 && -n "$2" ]] || fail '--prefix needs a directory.' 2
            prefix="$2"
            shift
            ;;
        --vault-source)
            [[ $# -ge 2 && -n "$2" ]] || fail '--vault-source needs a directory.' 2
            set_choice vault-source
            vault_source="$2"
            shift
            ;;
        --import-state)
            [[ $# -ge 2 && -n "$2" ]] || fail '--import-state needs a directory.' 2
            set_choice import-state
            import_state="$2"
            shift
            ;;
        --local-secrets) set_choice local-secrets ;;
        --keep-secrets) set_choice keep-secrets ;;
        --dry-run) dry_run=true ;;
        --skip-cli) skip_cli=true ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; fail "unknown argument: $1" 2 ;;
    esac
    shift
done

[[ -n "$choice" ]] || { choice_error; exit 2; }

[[ "$prefix" == /* ]] || fail "the prefix must be an absolute path, got '$prefix'." 2

# The code files. The installer itself stays in the source tree.
code_files=(node-9.env compose.yaml compose.vector-disk.yaml userinit.yml advertise.yml)
code_dirs=(bin schema ansible)
# The state names. A re-run never touches them.
state_dirs=(data secrets images)

# nearest_existing PATH  Print the nearest ancestor of PATH that exists.
nearest_existing() {
    local dir="$1"
    while [[ ! -d "$dir" ]]; do
        dir="$(dirname "$dir")"
    done
    (cd "$dir" && pwd -P)
}

# Refuse a prefix inside a git work tree.
anchor="$(nearest_existing "$prefix")"
if git -C "$anchor" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    fail "the prefix $prefix is inside the git work tree $(git -C "$anchor" rev-parse --show-toplevel). Node 9 must stay outside every source tree." 2
fi

# Refuse a non-empty prefix that has no marker.
[[ ! -L "$prefix/.installed" ]] \
    || fail "$prefix/.installed is a symbolic link. The marker must be a plain file." 2
if [[ -d "$prefix" && ! -f "$prefix/.installed" ]] \
   && [[ -n "$(ls -A "$prefix")" ]]; then
    fail "$prefix is not empty and has no .installed marker." 2
fi

# The seven keys that a complete plaintext set holds.
plaintext_keys=(CHAT_SERVICE_PASSWORD CHAT_ADMIN_PASSWORD \
    CHAT_EMBEDDING_OPENAI_API_KEY CHAT_USER_SIGMA_PASSWORD \
    CHAT_USER_THETA_PASSWORD CHAT_USER_PHI_PASSWORD \
    CHAT_USER_MARIO_PASSWORD)

# key_value KEY FILE  Print one value for an in-memory comparison. Never
# place this call in a line that prints its answer.
key_value() {
    sed -n "s/^$1=//p" "$2"
}

# complete_state DIR  Print the first gap in a plaintext set, or nothing.
# Each agent file must equal its key value. The check never prints a value.
complete_state() {
    local dir="$1" key name upper file
    [[ -L "$dir/secrets.env" ]] \
        && { printf '%s is a symbolic link' "$dir/secrets.env"; return; }
    [[ -f "$dir/secrets.env" ]] || { printf 'secrets.env is missing'; return; }
    for key in "${plaintext_keys[@]}"; do
        grep -q "^$key=." "$dir/secrets.env" \
            || { printf '%s is missing from secrets.env' "$key"; return; }
    done
    for name in Sigma Theta Phi; do
        upper="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')"
        file="$dir/secrets/$name.password"
        [[ -L "$file" ]] \
            && { printf 'secrets/%s.password is a symbolic link' "$name"; return; }
        [[ -f "$file" && -s "$file" ]] || { printf 'secrets/%s.password is missing' "$name"; return; }
        [[ "$(cat "$file")" == "$(key_value "CHAT_USER_${upper}_PASSWORD" "$dir/secrets.env")" ]] \
            || { printf 'secrets/%s.password does not match CHAT_USER_%s_PASSWORD' "$name" "$upper"; return; }
    done
}

# dir_gap DIR  Print the first reason a source directory is unusable.
dir_gap() {
    local dir="$1"
    [[ "$dir" == /* ]] || { printf 'the path must be absolute: %s' "$dir"; return; }
    [[ -d "$dir" ]] || { printf 'no directory at %s' "$dir"; return; }
    [[ -r "$dir" ]] || { printf 'the directory is not readable: %s' "$dir"; return; }
}

# inside_git DIR  Status 0 when DIR sits inside a git work tree.
inside_git() {
    local real
    real="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
    git -C "$real" rev-parse --is-inside-work-tree > /dev/null 2>&1
}

# vault_source_gap DIR  Print the first gap in a vault bundle, or nothing.
vault_source_gap() {
    local dir="$1" name file
    [[ -L "$dir" ]] && { printf '%s is a symbolic link' "$dir"; return; }
    for name in vault-pass shared.yml owner.yml; do
        file="$dir/$name"
        [[ -L "$file" ]] && { printf '%s is a symbolic link' "$file"; return; }
        [[ -f "$file" && -s "$file" ]] || { printf '%s is missing or empty' "$file"; return; }
        [[ -r "$file" ]] || { printf '%s is not readable' "$file"; return; }
    done
    for file in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
        [[ -e "$file" || -L "$file" ]] || continue
        name="${file##*/}"
        case "$name" in
            vault-pass|shared.yml|owner.yml) ;;
            *) printf '%s is not a bundle file' "$file"; return ;;
        esac
    done
}

# file_sha256 FILE  Print the SHA-256 of FILE on Darwin or Linux.
file_sha256() {
    case "$(uname -s)" in
        Darwin) shasum -a 256 "$1" | awk '{print $1}' ;;
        *) sha256sum "$1" | awk '{print $1}' ;;
    esac
}

# file_size FILE  Print the byte count.
file_size() {
    wc -c < "$1" | tr -d ' '
}

# plaintext_present  Status 0 when the home holds any plaintext secret path.
plaintext_present() {
    [[ -e "$prefix/secrets.env" || -L "$prefix/secrets.env" ]] && return 0
    [[ -L "$prefix/secrets" ]] && return 0
    [[ -n "$(ls -A "$prefix/secrets" 2>/dev/null)" ]] && return 0
    return 1
}

# legacy_state  Print absent, inert, link, altered or dangling for the
# in-home shared vault path of the earlier layout.
legacy_state() {
    local file="$prefix/ansible/vault/shared.yml" target
    if [[ -L "$file" ]]; then
        target="$(readlink "$file")"
        if [[ "$target" == "$stable_shared" && -f "$target" ]]; then
            printf 'link'
        else
            printf 'foreign-link'
        fi
        return
    fi
    if [[ -e "$file" ]]; then
        if [[ -f "$file" \
              && "$(file_sha256 "$file")" == "$legacy_shared_sha256" \
              && "$(file_size "$file")" == "$legacy_shared_size" ]]; then
            printf 'inert'
        else
            printf 'altered'
        fi
        return
    fi
    printf 'absent'
}

# state_target_status SOURCE  Print absent, keep, partial:PATH or mismatch:PATH
# for the plaintext targets under the prefix.
state_target_status() {
    local source="$1" name target present=0 total=0 i
    local -a sources=("$source/secrets.env")
    local -a targets=("$prefix/secrets.env")
    for name in Sigma Theta Phi; do
        sources+=("$source/secrets/$name.password")
        targets+=("$prefix/secrets/$name.password")
    done
    for target in "${targets[@]}"; do
        [[ -L "$target" ]] && { printf 'symlink:%s' "$target"; return; }
        total=$((total + 1))
        [[ -e "$target" ]] && present=$((present + 1))
    done
    if (( present == 0 )); then printf 'absent'; return; fi
    for target in "${targets[@]}"; do
        [[ -e "$target" ]] || { printf 'partial:%s' "$target"; return; }
    done
    for i in "${!targets[@]}"; do
        cmp -s "${sources[$i]}" "${targets[$i]}" \
            || { printf 'mismatch:%s' "${targets[$i]}"; return; }
    done
    printf 'keep'
}

# vault_action SOURCE TARGET  Print create, keep or conflict for a dry run.
vault_action() {
    local source="$1" target="$2"
    if [[ -e "$target" ]]; then
        if cmp -s "$source" "$target"; then printf 'keep'; else printf 'conflict'; fi
    else
        printf 'create'
    fi
}

# Stable vault and password paths. They live outside the code directory, so
# a code replacement removes neither.
vault_parent="$(dirname "$prefix")"
stable_shared="$vault_parent/vault/shared.yml"
stable_owner="$vault_parent/vault/owner.yml"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
vault_pass="$config_home/chat-node-9/vault-pass"

# Secrets preflight. It runs before the toolchain check and every copy.
if [[ "$choice" == 'vault-source' ]] \
   && git -C "$(nearest_existing "$vault_pass")" rev-parse --is-inside-work-tree \
      > /dev/null 2>&1; then
    fail "the vault password target $vault_pass is inside a git work tree." 2
fi
case "$choice" in
    vault-source)
        gap="$(dir_gap "$vault_source")"
        [[ -z "$gap" ]] || fail "$gap." 2
        if inside_git "$vault_source"; then
            fail "the vault source $vault_source is inside a git work tree. Keep vault material outside every source tree." 2
        fi
        gap="$(vault_source_gap "$vault_source")"
        [[ -z "$gap" ]] || fail "$gap." 2
        if plaintext_present; then
            fail "$prefix holds plaintext secrets. Use --keep-secrets for a reinstall." 2
        fi
        ;;
    import-state)
        gap="$(dir_gap "$import_state")"
        [[ -z "$gap" ]] || fail "$gap." 2
        gap="$(complete_state "$import_state")"
        [[ -z "$gap" ]] || fail "the import source is incomplete: $gap." 2
        ;;
    local-secrets)
        if plaintext_present; then
            fail "$prefix holds plaintext secrets. Use --keep-secrets for a reinstall." 2
        fi
        if [[ "$dry_run" != 'true' && ! -t 0 ]]; then
            fail '--local-secrets needs a terminal for the owner password.' 2
        fi
        ;;
    keep-secrets)
        [[ -f "$prefix/.installed" ]] \
            || fail "$prefix has no .installed marker. --keep-secrets is for a reinstall." 2
        gap="$(complete_state "$prefix")"
        [[ -z "$gap" ]] || fail "the existing plaintext state is incomplete: $gap." 2
        ;;
esac

if [[ -L "$stable_shared" ]]; then
    fail "$stable_shared is a symbolic link. Stable vault targets must be plain files." 2
fi
if [[ -L "$stable_owner" ]]; then
    fail "$stable_owner is a symbolic link. Stable vault targets must be plain files." 2
fi
if [[ -L "$vault_pass" ]]; then
    fail "$vault_pass is a symbolic link. The vault password must be a plain file." 2
fi

legacy="$(legacy_state)"
case "$legacy" in
    inert)
        printf 'node-9 install: the in-home shared.yml matches the last tracked artifact. The code replacement removes it.\n'
        ;;
    altered)
        fail "$prefix/ansible/vault/shared.yml differs from the last tracked artifact. Move it before installation." 1
        ;;
    foreign-link)
        fail "$prefix/ansible/vault/shared.yml is not a link to $stable_shared." 2
        ;;
esac

if [[ "$choice" == 'vault-source' ]]; then
    for pair in "shared.yml:$stable_shared" "owner.yml:$stable_owner"; do
        name="${pair%%:*}"
        target="${pair#*:}"
        if [[ -e "$target" ]] && ! cmp -s "$vault_source/$name" "$target"; then
            fail "$target differs from $vault_source/$name. It is not overwritten." 1
        fi
    done
    if [[ -e "$vault_pass" ]] && ! cmp -s "$vault_source/vault-pass" "$vault_pass"; then
        fail "$vault_pass differs from $vault_source/vault-pass. It is not overwritten." 1
    fi
fi

if [[ "$choice" == 'import-state' ]]; then
    status="$(state_target_status "$import_state")"
    case "$status" in
        absent|keep) ;;
        partial:*) fail "the target plaintext state is partial: ${status#partial:} is missing." 1 ;;
        mismatch:*) fail "${status#mismatch:} differs from the import source. It is not overwritten." 1 ;;
        symlink:*) fail "${status#symlink:} is a symbolic link. The import target must be a plain file." 1 ;;
    esac
fi

# NODE9_JAVA names the java of the version check. The build script writes the
# same java into the frozen options, so the installed launcher runs it.
# NODE9_MVN names the mvn of the build. The build script gives a named java to
# Maven through JAVA_HOME, so one name selects the build JDK and the run JDK.
# A run that names no java keeps the JAVA_HOME of the caller. The offline suite
# points both names at an absent command.
java_command="${NODE9_JAVA:-java}"
mvn_command="${NODE9_MVN:-mvn}"

# A java that answers nothing holds the install. The stub at /usr/bin/java does
# that when JAVA_HOME names no JDK, so the version probe takes a time limit.
# NODE9_JAVA_LIMIT sets the seconds, and the offline suite lowers it. The build
# script reads the same name. See CHAT-faqxupam.
java_limit_s="${NODE9_JAVA_LIMIT:-30}"
probe_lib="$src/../shell-scripts/java-probe.sh"
[[ -f "$probe_lib" ]] \
    || fail 'no java-probe.sh script beside the node-9 directory.' 2
# shellcheck source=../shell-scripts/java-probe.sh
. "$probe_lib"

# The shell CLI runtime needs Java. The check runs before every copy, so a
# host without Java keeps its earlier home and takes no partial one. See
# CHAT-bjqzvsoe.
java_version='skipped'
if [[ "$skip_cli" != 'true' ]]; then
    command -v "$java_command" > /dev/null 2>&1 \
        || fail "no java at $java_command. The shell CLI runtime needs Java $java_floor. Install Java, or pass --skip-cli." 2
    java_text="$(java_probe_run "$java_limit_s" "$java_command" -version)"
    java_probe_status=$?
    (( java_probe_status != 124 )) \
        || fail "the java at $java_command gave no version inside the $java_limit_s second time limit. Check JAVA_HOME." 2
    java_version="$(printf '%s' "$java_text" \
        | sed -nE 's/.*version "([0-9]+).*/\1/p' | head -1)"
    [[ -n "$java_version" ]] \
        || fail 'cannot read the java version. The shell CLI runtime needs a readable version.' 2
    (( java_version >= java_floor )) \
        || fail "java $java_version is at $java_command, and the shell CLI runtime needs Java $java_floor." 2
    command -v "$mvn_command" > /dev/null 2>&1 \
        || fail "no mvn at $mvn_command. The install builds the shell CLI runtime from source." 2
    [[ -x "$src/../shell-scripts/build-shell-cli-lib" ]] \
        || fail 'no build-shell-cli-lib script beside the node-9 directory.' 2
fi

if [[ "$dry_run" == 'true' ]]; then
    printf 'prefix: %s\n' "$prefix"
    printf 'choice: %s\n' "$choice"
    printf 'code: %s %s\n' "${code_files[*]}" "${code_dirs[*]}"
    printf 'java: %s\n' "$java_version"
    if [[ "$skip_cli" == 'true' ]]; then
        printf 'lib: skipped\n'
    else
        printf 'lib: one build of the jar set from %s\n' \
            "$(cd "$src/.." && pwd)"
    fi
    case "$choice" in
        vault-source)
            printf 'source: %s\n' "$vault_source/vault-pass"
            printf 'source: %s\n' "$vault_source/shared.yml"
            printf 'source: %s\n' "$vault_source/owner.yml"
            printf 'target: %s action: %s\n' \
                "$stable_shared" "$(vault_action "$vault_source/shared.yml" "$stable_shared")"
            printf 'target: %s action: %s\n' \
                "$stable_owner" "$(vault_action "$vault_source/owner.yml" "$stable_owner")"
            printf 'target: %s action: %s\n' \
                "$vault_pass" "$(vault_action "$vault_source/vault-pass" "$vault_pass")"
            printf 'playbook link: %s\n' "$prefix/ansible/vault/shared.yml"
            printf 'playbook link: %s\n' "$prefix/ansible/vault/owner.yml"
            printf 'plaintext: pending\n'
            printf 'next: %s/bin/setup-secrets\n' "$prefix"
            printf 'next: %s/bin/setup-secrets --owner\n' "$prefix"
            ;;
        import-state)
            printf 'source: %s\n' "$import_state"
            printf 'target: %s action: %s\n' \
                "$prefix/secrets.env" "$(state_target_status "$import_state")"
            printf 'plaintext: complete\n'
            ;;
        local-secrets)
            printf 'target: %s action: create\n' "$prefix/secrets.env"
            printf 'plaintext: complete\n'
            ;;
        keep-secrets)
            printf 'target: %s action: keep\n' "$prefix/secrets.env"
            printf 'plaintext: complete\n'
            ;;
    esac
    exit 0
fi

umask 022

# The jar set is built before any copy. A failed build then leaves the
# earlier home whole, with its code, its jar set, and its marker. The stage
# sits beside the prefix, so one rename completes it.
lib_stage=''
if [[ "$skip_cli" != 'true' ]]; then
    stage_parent="$(mktemp -d "$(dirname "$prefix")/.node9-install-XXXXXX")" \
        || fail 'no temporary directory for the jar set.' 1
    lib_stage="$stage_parent/lib"
    # The build takes the same two names that the check read, so the check and
    # the call never name two pairs. See the branch review of 2026-10-22.
    #
    # A name travels only when the caller set it. An earlier version passed
    # NODE9_JAVA on every run, so a default install named the java of the path.
    # The build script then replaced the JAVA_HOME of the caller with a derived
    # path, and the build held one core and printed no line. See CHAT-faqxupam.
    build_env=()
    [[ -n "${NODE9_JAVA:-}" ]] && build_env+=("NODE9_JAVA=$java_command")
    [[ -n "${NODE9_MVN:-}" ]] && build_env+=("NODE9_MVN=$mvn_command")
    if ! env "${build_env[@]+"${build_env[@]}"}" \
        "$src/../shell-scripts/build-shell-cli-lib" "$lib_stage" \
        > "$stage_parent/build.log" 2>&1; then
        printf 'node-9 install: the shell CLI build failed. Its log is at %s\n' \
            "$stage_parent/build.log" >&2
        exit 1
    fi
    printf 'node-9 install: %s\n' "$(tail -1 "$stage_parent/build.log")"
    rm -f "$stage_parent/build.log"
fi

mkdir -p "$prefix" || fail "cannot create $prefix." 1

# Replace the code. A directory is replaced whole, so a removed file goes.
for file in "${code_files[@]}"; do
    cp "$src/$file" "$prefix/$file" || fail "cannot copy $file." 1
done
for dir in "${code_dirs[@]}"; do
    rm -rf "${prefix:?}/$dir"
    cp -R "$src/$dir" "$prefix/$dir" || fail "cannot copy $dir." 1
done
cp "$src/../shell-scripts/chat-shell-cli" "$prefix/bin/chat-shell-cli" \
    || fail 'cannot copy the shell CLI launcher.' 1
rm -f "$prefix/ansible/vault/owner.yml"
chmod 755 "$prefix"/bin/*

# The jar set replaces the earlier one whole, so a dependency that left the
# build leaves the home. lib/ is code, not state.
#
# The earlier set moves aside first, and it returns when the new set cannot
# take its place. So a failed move leaves a working runtime. No rename can
# replace a directory that holds files, so the two renames leave one short
# window. A failure inside that window restores the earlier set.
# NODE9_INSTALL_FAIL_LIB_MOVE is a test hook of the offline suite.
# See the branch review of 2026-10-22.
if [[ -n "$lib_stage" ]]; then
    old_lib=''
    if [[ -d "$prefix/lib" ]]; then
        old_lib="$stage_parent/lib.old"
        mv "$prefix/lib" "$old_lib" \
            || fail "cannot move the earlier jar set out of $prefix/lib." 1
    fi
    if [[ "${NODE9_INSTALL_FAIL_LIB_MOVE:-}" == '1' ]] \
       || ! mv "$lib_stage" "$prefix/lib"; then
        if [[ -n "$old_lib" ]]; then
            mv "$old_lib" "$prefix/lib" \
                || fail "the jar set of $prefix/lib is lost. Run the install again." 1
            printf 'node-9 install: the new jar set did not move. The earlier set stays.\n' >&2
        fi
        fail "cannot move the jar set to $prefix/lib." 1
    fi
    rm -rf "$old_lib"
    rmdir "$stage_parent" 2> /dev/null
fi

# State directories. Create alone. Never change a present one.
for dir in "${state_dirs[@]}"; do
    [[ -d "$prefix/$dir" ]] && continue
    mkdir -p "$prefix/$dir"
    case "$dir" in
        secrets) chmod 700 "$prefix/$dir" ;;
    esac
done

# install_stable SOURCE TARGET  Create or keep one stable vault file.
install_stable() {
    local source="$1" target="$2"
    if [[ -e "$target" ]]; then
        cmp -s "$source" "$target" \
            || fail "$target differs from $source. It is not overwritten." 1
        chmod 0600 "$target"
        printf 'keep %s\n' "$target"
    else
        cp "$source" "$target" || fail "cannot copy $source to $target." 1
        chmod 0600 "$target"
        printf 'create %s\n' "$target"
    fi
}

# Apply the chosen secrets source. The preflight above accepted it.
case "$choice" in
    vault-source)
        mkdir -p "$vault_parent/vault" \
            || fail "cannot create $vault_parent/vault." 1
        install_stable "$vault_source/shared.yml" "$stable_shared"
        install_stable "$vault_source/owner.yml" "$stable_owner"
        mkdir -p "$config_home/chat-node-9" \
            || fail "cannot create $config_home/chat-node-9." 1
        chmod 0700 "$config_home/chat-node-9"
        install_stable "$vault_source/vault-pass" "$vault_pass"
        ;;
    import-state)
        case "$(state_target_status "$import_state")" in
            absent)
                cp "$import_state/secrets.env" "$prefix/secrets.env" \
                    || fail 'cannot copy secrets.env.' 1
                chmod 0600 "$prefix/secrets.env"
                for name in Sigma Theta Phi; do
                    file="$prefix/secrets/$name.password"
                    cp "$import_state/secrets/$name.password" "$file" \
                        || fail "cannot copy $name.password." 1
                    chmod 0600 "$file"
                done
                printf 'node-9 install: imported secrets from %s\n' "$import_state"
                ;;
            keep)
                printf 'node-9 install: the plaintext state matches %s; it is kept.\n' "$import_state"
                ;;
        esac
        ;;
    local-secrets)
        node9_write_local "$prefix/secrets.env" "$prefix/secrets" \
            || fail 'the local secret generation failed.' 1
        ;;
    keep-secrets) ;;
esac

# Link the stable vault files into the installed playbook paths. A stable
# file may exist from an earlier run, under any choice.
mkdir -p "$prefix/ansible/vault"
for name in shared.yml owner.yml; do
    stable="$vault_parent/vault/$name"
    if [[ -f "$stable" ]]; then
        ln -sfn "$stable" "$prefix/ansible/vault/$name"
    fi
done

case "$choice" in
    vault-source) marker_secrets=vault-source; marker_plaintext=pending ;;
    import-state) marker_secrets=import-state; marker_plaintext=complete ;;
    local-secrets) marker_secrets=local; marker_plaintext=complete ;;
    keep-secrets) marker_secrets=kept; marker_plaintext=complete ;;
esac

# The marker goes last. Its presence means the copy is complete.
{
    printf 'installed-at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'source-commit: %s\n' \
        "$(git -C "$src" rev-parse HEAD 2>/dev/null || printf unknown)"
    # The line reports the home, not the flag. --skip-cli on a home that
    # already holds a jar set keeps that set, and a reader of "skipped" would
    # otherwise expect no runtime. See the branch review of 2026-10-22.
    if [[ -n "$lib_stage" ]]; then
        printf 'cli: lib, java %s\n' "$java_version"
    elif [[ -f "$prefix/lib/shell-cli.options" ]]; then
        printf 'cli: lib, kept\n'
    else
        printf 'cli: skipped\n'
    fi
    printf 'secrets: %s\n' "$marker_secrets"
    printf 'plaintext: %s\n' "$marker_plaintext"
} > "$prefix/.installed"

if [[ "$choice" == 'vault-source' ]]; then
    printf 'node-9 install: code and ciphertext installed in %s; plaintext setup is pending.\n' "$prefix"
    printf 'node-9 install: run %s\n' "$prefix/bin/setup-secrets"
    printf 'node-9 install: run %s\n' "$prefix/bin/setup-secrets --owner"
else
    printf 'node-9 install: installed in %s\n' "$prefix"
fi
