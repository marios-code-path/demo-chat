#!/usr/bin/env bash
# Write the node-9 secrets. Ansible Vault holds the stored values.
#
#   node-9/bin/setup-secrets           Write the shared values from Vault.
#   node-9/bin/setup-secrets --owner   Write the owner value. The owner runs this.
#   node-9/bin/setup-secrets --local   Generate random values. No Ansible.
#
# A write is create-only. An existing key and an existing file keep their
# bytes. The default run never falls back to --local. See CHAT-jmnjvupr.
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$script_dir/lib.sh"
node9_require_installed || exit 2

usage() {
    printf 'usage: setup-secrets [--owner | --local]\n'
}

mode=shared
while (( $# )); do
    case "$1" in
        --owner) mode=owner ;;
        --local) mode=local ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'node-9: setup-secrets does not take %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

umask 077

target="${NODE9_SECRETS_FILE:-$NODE9_DIR/secrets.env}"
secrets_dir="${NODE9_SECRETS_DIR:-$NODE9_DIR/secrets}"
ansible_dir="${NODE9_ANSIBLE_DIR:-$NODE9_DIR/ansible}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
vault_pass="$config_home/chat-node-9/vault-pass"
owner_vault="$ansible_dir/vault/owner.yml"
# An installed copy has no repository, so no path is inside one.
repo_root=''
node9_installed || repo_root="$(cd "$NODE9_DIR/.." && pwd -P)"

# inside_repo PATH  True when PATH is in the repository tree.
inside_repo() {
    [[ -n "$repo_root" ]] || return 1
    local path="$1" real parent
    real="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)" || return 1
    printf '%s/%s' "$real" "$(basename "$path")" | grep -q "^$repo_root/" && return 0
    return 1
}

# refuse_symlink PATH  Stop when PATH is a symbolic link.
refuse_symlink() {
    if [[ -L "$1" ]]; then
        printf 'node-9: %s is a symbolic link. Secret paths must be plain files.\n' "$1" >&2
        exit 1
    fi
}

# run_playbook PLAYBOOK [VAULT_ID]  Run one playbook with the node 9 paths.
run_playbook() {
    local playbook="$1" vault_id="$2"
    ( cd "$ansible_dir" \
      && NODE9_SECRETS_FILE="$target" NODE9_SECRETS_DIR="$secrets_dir" \
         ansible-playbook "$playbook" -i localhost, -c local \
             --vault-id "$vault_id" )
}

# write_local  Generate every missing value without Ansible.
write_local() {
    local tmp key value mario
    refuse_symlink "$target"
    refuse_symlink "$secrets_dir"
    tmp="$(mktemp "${target}.XXXXXX")" || exit 1
    trap 'rm -f "$tmp"' EXIT
    if [[ -f "$target" ]]; then cp "$target" "$tmp"; fi
    chmod 0600 "$tmp"

    for key in CHAT_SERVICE_PASSWORD CHAT_ADMIN_PASSWORD CHAT_EMBEDDING_OPENAI_API_KEY \
               CHAT_USER_SIGMA_PASSWORD CHAT_USER_THETA_PASSWORD CHAT_USER_PHI_PASSWORD; do
        if ! grep -q "^$key=" "$tmp" 2>/dev/null; then
            printf '%s=%s\n' "$key" "$(openssl rand -hex 16)" >> "$tmp"
        fi
    done

    if ! grep -q '^CHAT_USER_MARIO_PASSWORD=' "$tmp" 2>/dev/null; then
        if [[ ! -t 0 ]]; then
            printf 'node-9: %s needs CHAT_USER_MARIO_PASSWORD. Run --local from a terminal, or ask the owner.\n' "$target" >&2
            exit 1
        fi
        printf 'Mario password: ' >&2
        IFS= read -rs mario
        printf '\n' >&2
        if [[ -z "$mario" ]]; then
            printf 'node-9: an empty owner password is not allowed.\n' >&2
            exit 1
        fi
        printf 'CHAT_USER_MARIO_PASSWORD=%s\n' "$mario" >> "$tmp"
    fi

    mkdir -p "$secrets_dir" && chmod 0700 "$secrets_dir"
    for key in Sigma Theta Phi; do
        local upper file
        upper="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')"
        file="$secrets_dir/$key.password"
        refuse_symlink "$file"
        if [[ ! -e "$file" ]]; then
            sed -n "s/^CHAT_USER_${upper}_PASSWORD=//p" "$tmp" > "$file"
            chmod 0600 "$file"
        fi
    done

    mv "$tmp" "$target"
    trap - EXIT
    chmod 0600 "$target"
    printf 'node-9: wrote %s and %s/ without Ansible.\n' "$target" "$secrets_dir"
}

case "$mode" in
    shared)
        if ! command -v ansible-playbook > /dev/null 2>&1; then
            printf 'node-9: ansible-playbook is not installed. Run setup-secrets --local.\n' >&2
            exit 1
        fi
        if [[ ! -f "$vault_pass" ]]; then
            printf 'node-9: %s is missing. Run setup-secrets --local.\n' "$vault_pass" >&2
            exit 1
        fi
        if inside_repo "$vault_pass"; then
            printf 'node-9: the vault password file must stay outside the repository.\n' >&2
            exit 1
        fi
        refuse_symlink "$target"
        run_playbook secrets-shared.yml "shared@$vault_pass" || exit 1
        ;;
    owner)
        if [[ ! -f "$owner_vault" ]]; then
            printf 'node-9: %s is missing. The owner creates it with ansible-vault create.\n' "$owner_vault" >&2
            exit 1
        fi
        refuse_symlink "$target"
        run_playbook secrets-owner.yml 'owner@prompt' || exit 1
        ;;
    local)
        write_local
        ;;
esac
