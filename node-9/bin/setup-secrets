#!/usr/bin/env bash
# Create node-9/secrets.env with random passwords. Never replace it.
# See CHAT-hcfgkbuz.
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$script_dir/lib.sh"

target="${NODE9_SECRETS_FILE:-$NODE9_DIR/secrets.env}"
if [[ -e "$target" ]]; then
    printf 'node-9: %s exists. It is not replaced.\n' "$target"
    exit 0
fi

umask 077
tmp="$(mktemp "$target.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
{
    printf 'CHAT_SERVICE_PASSWORD=%s\n' "$(openssl rand -hex 16)"
    printf 'CHAT_ADMIN_PASSWORD=%s\n' "$(openssl rand -hex 16)"
    printf 'CHAT_EMBEDDING_OPENAI_API_KEY=%s\n' 'replace-me'
} > "$tmp"
mv "$tmp" "$target"
trap - EXIT
chmod 0600 "$target"
printf 'node-9: wrote %s. Replace CHAT_EMBEDDING_OPENAI_API_KEY with the node-2 key.\n' "$target"
