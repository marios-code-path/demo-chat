#!/usr/bin/env bash
# Create one project register in node 9. See CHAT-jmnjvupr and
# docs/superpowers/specs/2026-10-24-project-register-design.md.
#
#   register-create <name> [<path>] [--source-date DATE] --as <owner>
#
# The command takes the register name as an argument. It reads no register
# variable. A path names one frozen register file. The command assigns one
# entry to each "## " section after the preamble. A path needs a source date,
# because the date enters the bundle hash and a retry repeats it. A date
# without a path is a caller error, so no value goes unused.
#
# A refusal prints one line on standard error and returns a nonzero status.
# Status 2 names invalid input or a bad source. Status 1 names a room of
# another register. The design file holds the complete status table.
set -uo pipefail

create_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$create_dir/lib.sh"
export REGISTER_IMPORT_LIB=1
# shellcheck source=register-import
source "$create_dir/register-import"
unset REGISTER_IMPORT_LIB

# create_error MESSAGE  Print one line on standard error and return 2.
create_error() {
    printf 'register-create: %s\n' "$1" >&2
    return 2
}

# create_slug HEADING  Print the short name of one heading.
# The short name is a slug. Lowercase letters and digits stay. Every other run
# of characters becomes one dash. A leading or trailing dash goes.
create_slug() {
    printf '%s' "$1" \
        | LC_ALL=C tr '[:upper:]' '[:lower:]' \
        | LC_ALL=C sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' \
            -e 's/^-//' -e 's/-$//'
}

# create_sections PATH  Print one row for each "## " heading of one file.
#
# A row holds six tab-separated fields: the section number, the heading line,
# the line after the first paragraph, the byte offset of the heading, the byte
# offset of the next heading or of the end of the file, and the heading text.
# Section 0 is the preamble, so the first heading is section 1. A title that
# holds a control character gives the field `!`, because such a character
# cannot pass a tab as data.
#
# The pass is byte-oriented, so the offsets agree with the splitter and the
# range cutter. See CHAT-jmnjvupr.
create_sections() {
    local path="$1" size
    size="$(bytes_of "$path")" || return 1
    LC_ALL=C awk -v end_offset="$size" '
        function emit(end_off) {
            if (title ~ /[[:cntrl:]]/) {
                printf "%d\t%d\t%d\t%d\t%d\t!\n", \
                    sec, start_line, after, start_off, end_off
            } else {
                printf "%d\t%d\t%d\t%d\t%d\t%s\n", \
                    sec, start_line, after, start_off, end_off, title
            }
        }
        {
            if (substr($0, 1, 3) == "## ") {
                if (sec > 0) {
                    if (inpara) after = NR
                    emit(off)
                }
                sec++
                start_line = NR
                start_off = off
                title = substr($0, 4)
                inpara = 1
                after = NR + 1
            } else if ($0 == "") {
                if (inpara) { after = NR; inpara = 0 }
            } else if (inpara) {
                after = NR + 1
            }
            off += length($0) + 1
        }
        END { if (sec > 0) emit(end_offset) }
    ' "$path"
}

# create_collision_error NAME ALLOWED
# Print one reason and return 1 when a room holds the name space of NAME.
# Return 0 and print nothing when the name space is free. A failed room list
# returns 1, because a failed read is not an empty room list.
#
# A register owns every room that starts with <name>-fr-. The first direction
# finds such a room. A room in ALLOWED is this run's own topic, so a retry
# resumes instead of a refusal. The second direction finds an existing
# register <other> when NAME starts with <other>-fr-. See CHAT-jmnjvupr.
create_collision_error() {
    local name="$1" allowed="${2:-}" out rooms room other
    out="$(import_cql 'SELECT DISTINCT name FROM chat_uuid.chat_room_name;' \
        2> /dev/null)" \
        || { printf 'the room list fails.\n'; return 1; }
    rooms="$(printf '%s\n' "$out" | cql_rows | sed '/^[[:space:]]*$/d')"
    room="$(printf '%s\n' "$rooms" \
        | awk -v prefix="$name-fr-" 'index($0, prefix) == 1' \
        | grep -vxF -f <(printf '%s\n' "$allowed") \
        | head -1)"
    if [[ -n "$room" ]]; then
        printf 'the room %s holds the name space %s-fr-.\n' "$room" "$name"
        return 1
    fi
    other="$(printf '%s\n' "$rooms" \
        | awk -v name="$name" 'NF && index(name, $0 "-fr-") == 1 { print; exit }')"
    if [[ -n "$other" ]]; then
        printf 'the register %s holds the name space %s-fr-.\n' "$other" "$other"
        return 1
    fi
    return 0
}

# create_empty NAME OWNER WORK_DIR
# Create one empty register: the room, its ownership proof, and the
# membership of the owner and of every declared agent. No source file exists,
# so the room holds no message. See CHAT-jmnjvupr.
create_empty() {
    local name="$1" owner="$2" work="$3" proof
    import_owner="$owner"
    import_work="$work"
    import_cli_path="$(import_cli)" || return
    import_credentials "$work" "$owner" || return $?
    # The owner login must reach the core. Without it the core creates the
    # room and writes no owner row, and the proof then fails on a room that
    # already exists. See CHAT-egdtmwfc.
    export_caller "$work" "$owner"
    add_topic_once "$name" || return 1
    proof="$(ownership_proof "$name")" \
        || { create_error "the ownership proof of $name fails"; return 1; }
    if [[ "$proof" != "$owner" ]]; then
        create_error "the * permission row of $name names $proof, not $owner"
        return 1
    fi
    join_all "$name" || return 1
    printf 'register-create: register %s is ready\n' "$name"
    return 0
}

# create_main ARGS...  Run one whole command.
create_main() {
    local name='' path='' date='' owner='' reason status
    local positional=0 work rows size first heading
    local sec start after start_off end_off title
    local slug short topic key holder section_bytes
    local entries='[]' sections='' topics='' hash

    while (( $# )); do
        case "$1" in
            --as)
                if (( $# < 2 )) || [[ -z "$2" ]]; then
                    create_error 'the flag --as needs a name'
                    return 2
                fi
                owner="$2"
                shift 2
                ;;
            --source-date)
                if (( $# < 2 )) || [[ -z "$2" ]]; then
                    create_error 'the flag --source-date needs a date'
                    return 2
                fi
                date="$2"
                shift 2
                ;;
            --*)
                create_error "the command does not take the argument $1"
                return 2
                ;;
            *)
                if (( positional == 0 )); then
                    name="$1"
                elif (( positional == 1 )); then
                    path="$1"
                else
                    create_error "the command does not take the argument $1"
                    return 2
                fi
                positional=$(( positional + 1 ))
                shift
                ;;
        esac
    done

    [[ -n "$name" ]] \
        || { create_error 'the command needs a register name'; return 2; }
    [[ -n "$owner" ]] \
        || { create_error 'the command needs --as <owner>'; return 2; }
    node9_require_installed || return 2
    # The collision check reads Cassandra through compose. Compose needs the
    # fixed values of node-9.env with no caller value. See CHAT-ecpenmgk.
    node9_load_env || return 2
    reason="$(node9_register_name_error "$name")" \
        || { create_error "$reason"; return 2; }
    if [[ -n "$date" && ! "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        create_error "the source date $date is not one ISO date"
        return 2
    fi

    if [[ -n "$path" ]]; then
        [[ "$path" == /* ]] \
            || { create_error "the path $path is not absolute"; return 2; }
        [[ ! -L "$path" ]] \
            || { create_error "the path $path is a symbolic link"; return 2; }
        [[ -f "$path" ]] \
            || { create_error "the path $path is not a regular file"; return 2; }
        [[ -r "$path" ]] \
            || { create_error "the path $path is not readable"; return 2; }
        [[ -n "$date" ]] \
            || { create_error 'a path needs --source-date'; return 2; }
    elif [[ -n "$date" ]]; then
        create_error 'the flag --source-date needs a path'
        return 2
    fi

    umask 077
    work="$(mktemp -d)" || { create_error 'no temporary directory'; return 2; }
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" EXIT

    if [[ -n "$path" ]]; then
        hash="$(hash_of "$path")" \
            || { create_error "the source hash of $path fails"; return 2; }
        rows="$(create_sections "$path")" \
            || { create_error "the source $path does not read"; return 2; }
        heading="$(printf '%s\n' "$rows" | head -1 | cut -f2)"
        [[ -n "$heading" ]] \
            || { create_error "the source $path holds no '## ' section"; return 2; }
        if [[ "$heading" == '1' ]]; then
            create_error "the source $path has no preamble"
            return 2
        fi

        while IFS=$'\t' read -r sec start after start_off end_off title; do
            [[ -n "$sec" ]] || continue
            section_bytes=$(( end_off - start_off ))
            if (( section_bytes > REGISTER_IMPORT_RANGE_LIMIT )); then
                create_error "section $sec holds $section_bytes bytes, above the limit of $REGISTER_IMPORT_RANGE_LIMIT"
                return 2
            fi
            if [[ "$title" == '!' ]]; then
                create_error "section $sec: the title holds a control character"
                return 2
            fi
            reason="$(node9_title_error "$title")" \
                || { create_error "section $sec: $reason"; return 2; }
            slug="$(create_slug "$title")"
            if [[ -z "$slug" ]]; then
                create_error "section $sec has no short name"
                return 2
            fi
            short="$slug"
            if [[ -n "$sections" ]] \
                  && printf '%s' "$sections" | awk -F'\t' -v short="$slug" \
                      '$2 == short { found = 1 } END { exit !found }'; then
                short="$slug-$sec"
                holder="$(printf '%s' "$sections" \
                    | awk -F'\t' -v short="$short" \
                        '$2 == short { print $1; exit }')"
                if [[ -n "$holder" ]]; then
                    create_error "the short name $short of section $sec is held by section $holder"
                    return 2
                fi
            fi
            if [[ "$short" =~ ^snapshot-[0-9a-f]{12}$ ]]; then
                create_error "section $sec takes the snapshot short name $short"
                return 2
            fi
            topic="$name-fr-$short"
            if [[ ! "$topic" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]]; then
                create_error "section $sec: the topic $topic is not a valid topic name"
                return 2
            fi
            if [[ "$title" =~ CHAT-[a-z0-9]+ ]]; then
                key="${BASH_REMATCH[0]}"
            else
                key="section-$sec"
            fi
            reason="$(node9_key_error "$key")" \
                || { create_error "section $sec: $reason"; return 2; }
            entries="$(jq -c --arg key "$key" --arg topic "$topic" \
                --arg title "$title" --argjson first "$start" \
                --argjson last "$after" \
                '. + [{key: $key, topic: $topic, title: $title,
                       first_line: $first, after_line: $last}]' \
                <<< "$entries")" \
                || { create_error 'the mapping entry fails'; return 2; }
            sections="$sections$sec"$'\t'"$short"$'\n'
            topics="$topics$topic"$'\n'
        done <<< "$rows"

        reason="$(create_collision_error "$name" \
            "$(printf '%s-fr-snapshot-%s\n%s' "$name" "${hash:0:12}" "$topics")")"
        status=$?
        if (( status != 0 )); then
            printf 'register-create: %s\n' "$reason" >&2
            return 1
        fi

        jq -cS -n --arg sha "$hash" --arg date "$date" \
            --arg basis "register-create $name" \
            --argjson heading "$heading" --argjson entries "$entries" \
            '{version: 1, source_sha256: $sha, source_date: $date,
              source_basis: $basis,
              session: {first_line: 1, after_line: $heading},
              entries: $entries}' > "$work/mapping.json" \
            || { create_error 'the mapping does not reach a private file'; return 2; }

        pack_bundle --source "$path" --mapping "$work/mapping.json" \
            --bundle "$work/bundle" --register "$name" || return $?
        apply_bundle --bundle "$work/bundle" --as "$owner" \
            --register "$name" || return $?
        verify_bundle --bundle "$work/bundle" --as "$owner" \
            --register "$name" || return $?
        printf 'register-create: register %s is ready\n' "$name"
        return 0
    fi

    reason="$(create_collision_error "$name")"
    status=$?
    if (( status != 0 )); then
        printf 'register-create: %s\n' "$reason" >&2
        return 1
    fi
    create_empty "$name" "$owner" "$work"
}

create_main "$@"
exit $?
