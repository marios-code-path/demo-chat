# Launch values for node 9. This file holds no secret.
# A value already in the caller's environment wins. See CHAT-hcfgkbuz.
NODE9_PROJECT=chat-node-9
NODE9_VECTOR_PERSIST=on
NODE9_RSOCKET_PORT=6890
NODE9_MGMT_PORT=6891
NODE9_IMAGE_REPO=node-9
CORE_IMAGE=node-9/cassandra-core-service-rsocket:0.0.1
CASSANDRA_VERSION=4.1.3
REDIS_VERSION=7
CONSUL_VERSION=2.0.4
CHAT_EMBEDDING_OPENAI_BASE_URL=http://node2.lan:6090/v1
CHAT_EMBEDDING_OPENAI_MODEL=nomic-embed-text-v1.5.Q8_0.gguf
CHAT_EMBEDDING_IDENTITY=nomic-embed-text-v1-5-768
VECTOR_OWNER=1002:1001
